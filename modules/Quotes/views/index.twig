{% extends "layouts/default.twig" %}
{% block title %}Quotes — NovaNuke{% endblock %}
{% block content %}
<section class="content-page module-page">
  {% include 'components/breadcrumbs.twig' with {items: [{label: 'Home', url: '/'}, {label: 'Quotes'}]} only %}
  {% include 'components/page-header.twig' with {eyebrow: 'Example module', title: 'Quotes', description: 'A deliberately small reference module built on the public NovaNuke Module API.'} only %}
  {% if quotes %}
  <div class="content-list">
    {% for quote in quotes %}
      <article class="content-card"><blockquote>“{{ quote.quote_text }}”</blockquote>{% if quote.attribution %}<p>— {{ quote.attribution }}</p>{% endif %}</article>
    {% endfor %}
  </div>
  {% else %}
      {% include 'components/empty-state.twig' with {title: 'No published quotes', message: 'Published quotes will appear here once an administrator adds them.'} only %}
  {% endif %}
</section>
{% endblock %}
