{% extends "layouts/default.twig" %}{% block title %}Comments administration — NovaNuke{% endblock %}{% block content %}
<section class="admin-page"><p class="eyebrow">Community</p><h1>Comments</h1><p>Moderate conversations, review abuse reports and choose the public comment policy.</p>
{% if message %}<div class="success-message">{{ message }}</div>{% endif %}{% if error %}<div class="form-errors"><p>{{ error }}</p></div>{% endif %}
<form class="editor-panel" method="post" action="/admin/comments/settings"><input type="hidden" name="_token" value="{{ csrf_token }}"><h2>Comment policy</h2><label class="toggle-row"><input type="checkbox" name="guests_allowed" value="1" {{ guests_allowed ? 'checked' : '' }}><span><strong>Guest comments</strong><small>Allow visitors without an account to submit comments.</small></span></label><label class="toggle-row"><input type="checkbox" name="moderation_required" value="1" {{ moderation_required ? 'checked' : '' }}><span><strong>Require moderation</strong><small>New comments stay pending until a moderator approves them.</small></span></label><button type="submit">Save policy</button></form>
<h2>Moderation queue</h2><div class="table-wrap"><table class="admin-table"><thead><tr><th>Comment</th><th>Target</th><th>Status</th><th>Reports</th><th>Moderate</th></tr></thead><tbody>{% for comment in queue %}<tr><td><strong>{{ comment.author }}</strong><small>{{ comment.created_at }}</small><span class="comment-preview">{{ comment.body }}</span></td><td>{{ comment.content_type }} #{{ comment.content_id }}</td><td><span class="badge {{ comment.status == 'approved' ? 'badge-active' : '' }}">{{ comment.status }}</span></td><td>{{ comment.open_reports }}</td><td><form class="inline-form" method="post" action="/admin/comments/{{ comment.id }}/moderate"><input type="hidden" name="_token" value="{{ csrf_token }}"><select name="status"><option value="approved">Approved</option><option value="pending">Pending</option><option value="spam">Spam</option><option value="deleted">Deleted</option></select><button type="submit">Apply</button></form></td></tr>{% else %}<tr><td colspan="5">No comments to moderate.</td></tr>{% endfor %}</tbody></table></div>
<h2>Open reports</h2><div class="table-wrap"><table class="admin-table"><thead><tr><th>Comment</th><th>Reporter</th><th>Reason</th><th></th></tr></thead><tbody>{% for report in reports %}<tr><td>#{{ report.comment_id }}<small>{{ report.body }}</small></td><td>{{ report.reporter }}</td><td>{{ report.reason }}<small>{{ report.created_at }}</small></td><td><form method="post" action="/admin/comment-reports/{{ report.id }}/resolve"><input type="hidden" name="_token" value="{{ csrf_token }}"><button type="submit">Resolve</button></form></td></tr>{% else %}<tr><td colspan="4">No open reports.</td></tr>{% endfor %}</tbody></table></div><p><a class="auth-link" href="/admin">Return to dashboard</a></p></section>
{% endblock %}
