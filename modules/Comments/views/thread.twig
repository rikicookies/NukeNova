{% macro branch(items, content_type, content_id, csrf_token, return_to, current_user, depth) %}
    {% import _self as tree %}
    {% for comment in items %}
        <article class="comment comment-depth-{{ depth }}" id="comment-{{ comment.id }}">
            <header><strong>{{ comment.username|default(comment.guest_name|default('Former member', true), true) }}</strong><small>{{ comment.created_at|date(cms_date_format, cms_timezone) }}{% if comment.edited_at %} · edited{% endif %}</small></header>
            <div class="comment-body">{{ comment.body|nl2br }}</div>
            <div class="comment-actions">
                <details><summary>Reply</summary>
                    <form method="post" action="/comments/{{ content_type }}/{{ content_id }}">
                        <input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="return_to" value="{{ return_to }}"><input type="hidden" name="parent_id" value="{{ comment.id }}">
                        {% if not current_user %}<label>Name<input name="guest_name" required minlength="2" maxlength="100"></label>{% endif %}
                        <label>Reply<textarea name="body" required minlength="2" maxlength="5000"></textarea></label><button type="submit">Submit reply</button>
                    </form>
                </details>
                {% if current_user and comment.user_id == current_user.id %}<details><summary>Edit</summary>
                    <form method="post" action="/comments/{{ comment.id }}/edit"><input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="return_to" value="{{ return_to }}"><label>Comment<textarea name="body" required minlength="2" maxlength="5000">{{ comment.body }}</textarea></label><button type="submit">Save</button></form>
                </details>{% endif %}
                <details><summary>Report</summary>
                    <form method="post" action="/comments/{{ comment.id }}/report"><input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="return_to" value="{{ return_to }}"><label>Reason<textarea name="reason" required minlength="5" maxlength="500"></textarea></label><button type="submit">Send report</button></form>
                </details>
            </div>
            {% if comment.children %}<div class="comment-children">{{ tree.branch(comment.children, content_type, content_id, csrf_token, return_to, current_user, depth + 1) }}</div>{% endif %}
        </article>
    {% endfor %}
{% endmacro %}
{% import _self as tree %}
<section class="comments-section" id="comments">
    <header><p class="eyebrow">Community</p><h2>Comments</h2></header>
    {% if message %}<div class="success-message">{{ message }}</div>{% endif %}
    {% if error %}<div class="form-errors"><p>{{ error }}</p></div>{% endif %}
    {% if current_user or guests_allowed %}
        <form class="comment-form" method="post" action="/comments/{{ content_type }}/{{ content_id }}">
            <input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="return_to" value="{{ return_to }}">
            {% if not current_user %}<label>Name<input name="guest_name" required minlength="2" maxlength="100"></label>{% endif %}
            <label>Your comment<textarea name="body" required minlength="2" maxlength="5000"></textarea></label><button type="submit">Post comment</button>
        </form>
    {% else %}<p><a href="/login">Sign in</a> to join the conversation.</p>{% endif %}
    <div class="comment-list">{{ tree.branch(comments, content_type, content_id, csrf_token, return_to, current_user, 0) }}</div>
    {% if comments is empty %}<p class="comments-empty">No approved comments yet.</p>{% endif %}
</section>
