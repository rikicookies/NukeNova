{% extends "layouts/default.twig" %}{% block title %}News — NovaNuke{% endblock %}{% block content %}<section class="news-page"><header><p class="eyebrow">Latest</p><h1>News</h1><nav class="category-links"><a href="/news">All</a>{% for category in categories %}<a href="/news/category/{{ category.slug }}">{{ category.name }}</a>{% endfor %}<a href="/news/rss.xml">RSS</a></nav></header><div class="news-list">{% for article in result.items %}<article class="news-card">{% if article.is_featured %}<span class="badge badge-active">Featured</span>{% endif %}<h2><a href="/news/{{ article.slug }}">{{ article.title }}</a></h2><p>{{ article.summary|default('', true) }}</p><small>{{ article.category_name|default('Uncategorized', true) }} · {{ article.username }} · {{ article.published_at }}</small></article>{% else %}<p>No published news found.</p>{% endfor %}</div>{% if result.pages > 1 %}<nav class="pagination">{% for page in 1..result.pages %}<a class="{{ page == result.page ? 'current' : '' }}" href="?page={{ page }}">{{ page }}</a>{% endfor %}</nav>{% endif %}</section>{% endblock %}
