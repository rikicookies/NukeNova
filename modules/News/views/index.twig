{% extends "layouts/default.twig" %}{% block title %}News — NovaNuke{% endblock %}{% block content %}<section class="news-page">{% include 'components/breadcrumbs.twig' with {items: [{label: 'News'}]} only %}{% set header_actions = manage_url ? [{label: 'Manage', url: manage_url}, {label: 'RSS', url: '/news/rss.xml'}] : [{label: 'RSS', url: '/news/rss.xml'}] %}{% include 'components/page-header.twig' with {eyebrow: 'Latest', title: 'News', actions: header_actions} only %}<nav class="category-links"><a href="/news">All</a>{% for category in categories %}<a href="/news/category/{{ category.slug }}">{{ category.name }}</a>{% endfor %}</nav><div class="news-list">{% for article in result.items %}<article class="news-card">{% if article.is_featured %}<span class="badge badge-active">Featured</span>{% endif %}<h2><a href="/news/{{ article.slug }}">{{ article.title }}</a></h2><div class="news-summary">{{ article.summary_html }}</div><small>{{ article.category_name|default('Uncategorized', true) }} · {{ article.username }} · {{ article.published_at|date(cms_date_format, cms_timezone) }}</small></article>{% else %}{% include 'components/empty-state.twig' with {title: 'No news found', message: 'Published articles available to your account will appear here.'} only %}{% endfor %}</div>{% include 'components/pagination.twig' with {current_page: result.page, total_pages: result.pages, url_template: '?page={page}', label: 'News pages'} only %}</section>{% endblock %}
