{% extends "layouts/default.twig" %}{% block title %}News administration — NovaNuke{% endblock %}{% block content %}
<section class="admin-page">{% include 'components/breadcrumbs.twig' with {items: [{label: 'Admin', url: '/admin'}, {label: 'News'}]} only %}{% include 'components/page-header.twig' with {eyebrow: 'Editorial', title: 'News', description: 'Create drafts, schedule publications and organize the news archive.', actions: [{label: 'Create article', url: '/admin/news/new'}, {label: 'View news', url: '/news'}]} only %}{% if message %}<div class="success-message">{{ message }}</div>{% endif %}
{% set audience_labels = {'public':'Public','member':'Registered members','vip':'Active VIP members'} %}<div class="table-wrap"><table class="admin-table"><thead><tr><th>Article</th><th>Status</th><th>Audience</th><th>Category</th><th>Publication</th><th>Actions</th></tr></thead><tbody>{% for article in articles %}<tr><td><strong>{{ article.title }}</strong><small>{{ article.slug }} · {{ article.username }}</small></td><td><span class="badge {{ article.status == 'published' ? 'badge-active' : '' }}">{{ article.status }}</span></td><td>{{ audience_labels[article.audience]|default(article.audience) }}</td><td>{{ article.category_name|default('—', true) }}</td><td>{{ article.published_at|default('—', true) }}</td><td class="admin-actions-cell">{% include 'components/admin-row-actions.twig' with {label: 'Actions for ' ~ article.title, actions: article.status == 'published' ? [{label: 'Edit', url: '/admin/news/' ~ article.id ~ '/edit'}, {label: 'View', url: '/news/' ~ article.slug}] : [{label: 'Edit', url: '/admin/news/' ~ article.id ~ '/edit'}]} only %}</td></tr>{% else %}{% include 'components/admin-table-empty.twig' with {colspan: 6, title: 'No news articles', message: 'Create the first draft to begin the news archive.', action_url: '/admin/news/new', action_label: 'Create article'} only %}{% endfor %}</tbody></table></div>
<div class="taxonomy-grid"><form class="editor-panel" method="post" action="/admin/news/taxonomy/category"><input type="hidden" name="_token" value="{{ csrf_token }}"><h2>Create category</h2><label>Name<input name="name" required maxlength="120"></label><label>Slug<input name="slug" required pattern="[a-z0-9-]+"></label><label>Description<textarea name="description" maxlength="500"></textarea></label><button type="submit">Add category</button></form><form class="editor-panel" method="post" action="/admin/news/taxonomy/topic"><input type="hidden" name="_token" value="{{ csrf_token }}"><h2>Create topic</h2><label>Name<input name="name" required maxlength="120"></label><label>Slug<input name="slug" required pattern="[a-z0-9-]+"></label><label>Description<textarea name="description" maxlength="500"></textarea></label><button type="submit">Add topic</button></form></div>
</section>{% endblock %}
