{% extends "layouts/default.twig" %}{% set editor_title = article.id|default(false) ? 'Edit news' : 'Create news' %}{% block title %}{{ editor_title }} — NovaNuke{% endblock %}{% block content %}
<section class="admin-page">{% include 'components/breadcrumbs.twig' with {items: [{label: 'Admin', url: '/admin'}, {label: 'News', url: '/admin/news'}, {label: editor_title}]} only %}{% include 'components/page-header.twig' with {eyebrow: 'Editorial', title: editor_title, description: article.id|default(false) ? 'Update this news article without changing its publication workflow.' : 'Create a news article using the existing publication workflow.'} only %}{% if error %}<div class="form-errors"><ul><li>{{ error }}</li></ul></div>{% endif %}<form class="news-editor" method="post" action="/admin/news/save"><input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="id" value="{{ article.id|default('') }}">
<div class="form-grid"><label>Title<input name="title" required maxlength="200" value="{{ article.title|default('') }}"></label><label>Slug<input name="slug" required maxlength="200" pattern="[a-z0-9]+(-[a-z0-9]+)*" value="{{ article.slug|default('') }}"></label><label>Category<select name="category_id"><option value="">None</option>{% for category in categories %}<option value="{{ category.id }}" {{ article.category_id|default(null) == category.id ? 'selected' : '' }}>{{ category.name }}</option>{% endfor %}</select></label><label>Topic<select name="topic_id"><option value="">None</option>{% for topic in topics %}<option value="{{ topic.id }}" {{ article.topic_id|default(null) == topic.id ? 'selected' : '' }}>{{ topic.name }}</option>{% endfor %}</select></label></div>
<div class="form-grid"><label>Summary format<select name="summary_format"><option value="html">Sanitized HTML</option><option value="markdown" {{ article.summary_format|default('html') == 'markdown' ? 'selected' : '' }}>Markdown</option></select></label><label>Content format<select name="content_format"><option value="html">Sanitized HTML</option><option value="markdown" {{ article.content_format|default('html') == 'markdown' ? 'selected' : '' }}>Markdown</option></select></label></div>
<label class="wide-field">Summary<textarea name="summary" rows="3" maxlength="1000">{{ article.summary|default('', true) }}</textarea></label><label class="wide-field">Content<textarea name="content" rows="14" required>{{ article.content|default('') }}</textarea><small>HTML is sanitized when rendered. Markdown does not execute embedded HTML or unsafe links.</small></label>
<div class="form-grid"><label>Tags<input name="tags" value="{{ article.tags|default('') }}" placeholder="updates, community"></label><label>Featured image path<input name="featured_image" list="news-media-images" value="{{ article.featured_image|default('', true) }}" placeholder="/uploads/media/..."><small>{% if media_available %}Choose an uploaded image or <a href="/admin/media">open Media</a>.{% else %}Activate Media for managed images.{% endif %}</small></label><label>Status<select name="status"><option value="draft">Draft</option>{% if can_publish %}<option value="scheduled" {{ article.status|default('draft') == 'scheduled' ? 'selected' : '' }}>Scheduled</option><option value="published" {{ article.status|default('draft') == 'published' ? 'selected' : '' }}>Published</option>{% endif %}</select></label><label>Publication time (UTC)<input type="datetime-local" name="published_at" value="{{ article.published_at|default('', true)|replace({' ': 'T'}) }}"></label><label>SEO title<input name="seo_title" maxlength="200" value="{{ article.seo_title|default('', true) }}"></label><label>SEO description<textarea name="seo_description" maxlength="320">{{ article.seo_description|default('', true) }}</textarea></label></div>{% if media_available %}<datalist id="news-media-images">{% for image in media_images %}<option value="{{ image.public_path }}">{{ image.title|default(image.original_name,true) }}</option>{% endfor %}</datalist>{% endif %}
<fieldset class="editor-panel"><legend>Audience</legend><label><input type="radio" name="audience" value="public" {{ article.audience|default('public') == 'public' ? 'checked' : '' }}> Public</label><label><input type="radio" name="audience" value="member" {{ article.audience|default('public') == 'member' ? 'checked' : '' }}> Registered members</label><label><input type="radio" name="audience" value="vip" {{ article.audience|default('public') == 'vip' ? 'checked' : '' }}> Active VIP members</label></fieldset>
<div class="inline-checks"><label><input type="checkbox" name="is_featured" value="1" {{ article.is_featured|default(0) ? 'checked' : '' }}> Featured</label><label><input type="checkbox" name="comments_enabled" value="1" {{ article.comments_enabled|default(1) ? 'checked' : '' }}> Allow comments</label></div><button type="submit">Save article</button></form>
{% if article.id|default(false) %}<form class="delete-block-form" method="post" action="/admin/news/{{ article.id }}/delete"><input type="hidden" name="_token" value="{{ csrf_token }}"><label><input type="checkbox" name="confirm_delete" value="1" required> Confirm deletion</label><button class="danger-button" type="submit">Delete article</button></form>{% endif %}</section>{% endblock %}
