{% extends "layouts/default.twig" %}
{% block title %}{{ article.seo_title|default(article.title, true) }} — NovaNuke{% endblock %}
{% block meta %}{% if article.seo_description %}<meta name="description" content="{{ article.seo_description }}">{% endif %}{% endblock %}
{% block content %}
<article class="news-article">
    <header>
        {% if article.is_featured %}<span class="badge badge-active">Featured</span>{% endif %}
        <h1>{{ article.title }}</h1>
        <p>{{ article.summary|default('', true) }}</p>
        <small>By {{ article.username }} · {{ article.published_at }} · {{ article.view_count }} views</small>
    </header>
    {% if article.featured_image %}<img src="{{ article.featured_image }}" alt="">{% endif %}
    <div class="article-content">{{ article.content_html }}</div>
    {% if article.tag_list %}<footer>Tags: {{ article.tag_list|join(', ') }}</footer>{% endif %}
    <p><a href="/news">Return to news</a></p>
</article>
{% if comments_available %}
    {% include '@comments/thread.twig' with {
        content_type: 'news', content_id: article.id, comments: comments,
        guests_allowed: comments_guests_allowed, csrf_token: comments_csrf_token,
        return_to: comments_return_to, message: comments_message, error: comments_error,
        current_user: comments_user
    } only %}
{% elseif article.comments_enabled %}
    <p class="comments-unavailable">Comments are temporarily unavailable.</p>
{% endif %}
{% endblock %}
