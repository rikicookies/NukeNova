{% extends "layouts/default.twig" %}{% block title %}Downloads — NovaNuke{% endblock %}{% block content %}
<section class="downloads-page">{% include 'components/breadcrumbs.twig' with {items: [{label: 'Downloads'}]} only %}{% set header_actions = manage_url ? [{label: 'Manage', url: manage_url}] : [] %}{% include 'components/page-header.twig' with {eyebrow: 'Resources', title: 'Downloads', actions: header_actions} only %}<nav class="category-links"><a href="/downloads">All</a>{% for category in categories %}<a href="/downloads/category/{{ category.slug }}">{{ category.parent_name ? category.parent_name ~ ' / ' : '' }}{{ category.name }}</a>{% endfor %}</nav><form class="download-filters" method="get"><input name="q" maxlength="100" value="{{ search }}" placeholder="Search downloads"><select name="order"><option value="new">Newest</option><option value="popular" {{ order == 'popular' ? 'selected' : '' }}>Popular</option><option value="name" {{ order == 'name' ? 'selected' : '' }}>Name</option></select><button type="submit">Search</button></form>
<div class="download-grid">{% for item in result.items %}<article class="download-card">{% if item.image_path %}<img src="{{ item.image_path }}" alt="">{% endif %}{% if item.is_featured %}<span class="badge badge-active">Featured</span>{% endif %}<h2><a href="/downloads/{{ item.slug }}">{{ item.name }}</a></h2><p>{{ item.description_text|slice(0, 220) }}</p><small>{{ item.category_name|default('Uncategorized', true) }} · {{ item.download_count }} downloads{% if item.version %} · v{{ item.version }}{% endif %}</small></article>{% else %}{% include 'components/empty-state.twig' with {title: 'No downloads found', message: 'Try another category or remove some filters.'} only %}{% endfor %}</div>{% set pagination_url = '?q=' ~ (search|url_encode) ~ '&order=' ~ (order|url_encode) ~ '&page={page}' %}{% include 'components/pagination.twig' with {current_page: result.page, total_pages: result.pages, url_template: pagination_url, label: 'Download pages'} only %}</section>
{% endblock %}
