{% extends "layouts/default.twig" %}{% block title %}Downloads — NovaNuke{% endblock %}{% block content %}
<section class="downloads-page"><header><p class="eyebrow">Resources</p><h1>Downloads</h1><nav class="category-links"><a href="/downloads">All</a>{% for category in categories %}<a href="/downloads/category/{{ category.slug }}">{{ category.parent_name ? category.parent_name ~ ' / ' : '' }}{{ category.name }}</a>{% endfor %}</nav><form class="download-filters" method="get"><input name="q" maxlength="100" value="{{ search }}" placeholder="Search downloads"><select name="order"><option value="new">Newest</option><option value="popular" {{ order == 'popular' ? 'selected' : '' }}>Popular</option><option value="name" {{ order == 'name' ? 'selected' : '' }}>Name</option></select><button type="submit">Search</button></form></header>
<div class="download-grid">{% for item in result.items %}<article class="download-card">{% if item.image_path %}<img src="{{ item.image_path }}" alt="">{% endif %}{% if item.is_featured %}<span class="badge badge-active">Featured</span>{% endif %}<h2><a href="/downloads/{{ item.slug }}">{{ item.name }}</a></h2><p>{{ item.description|striptags|slice(0, 220) }}</p><small>{{ item.category_name|default('Uncategorized', true) }} · {{ item.download_count }} downloads{% if item.version %} · v{{ item.version }}{% endif %}</small></article>{% else %}<p>No downloads found.</p>{% endfor %}</div>{% if result.pages > 1 %}<nav class="pagination">{% for page in 1..result.pages %}<a class="{{ page == result.page ? 'current' : '' }}" href="?q={{ search|url_encode }}&order={{ order }}&page={{ page }}">{{ page }}</a>{% endfor %}</nav>{% endif %}</section>
{% endblock %}
