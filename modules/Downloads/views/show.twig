{% extends "layouts/default.twig" %}{% block title %}{{ download.name }} — Downloads — NovaNuke{% endblock %}{% block content %}
<article class="download-detail">{% if message %}<div class="success-message">{{ message }}</div>{% endif %}{% if error %}<div class="form-errors"><p>{{ error }}</p></div>{% endif %}<header>{% if download.is_featured %}<span class="badge badge-active">Featured</span>{% endif %}<h1>{{ download.name }}</h1><p>{{ download.category_name|default('Uncategorized', true) }} · {{ download.download_count }} downloads</p></header>{% if download.image_path %}<img src="{{ download.image_path }}" alt="">{% endif %}<div class="article-content">{{ download.description_html }}</div>
<dl class="download-meta"><dt>Version</dt><dd>{{ download.version|default('—', true) }}</dd><dt>Author</dt><dd>{{ download.author_name|default('—', true) }}</dd><dt>License</dt><dd>{{ download.license_name|default('—', true) }}</dd><dt>Size</dt><dd>{{ download.file_size ? (download.file_size / 1048576)|number_format(2) ~ ' MB' : 'External file' }}</dd><dt>Requirements</dt><dd>{{ download.requirements|default('—', true) }}</dd></dl><p><a class="download-button" href="/downloads/{{ download.slug }}/get">Download</a></p>
<details class="report-download"><summary>Report broken download</summary><form method="post" action="/downloads/{{ download.id }}/report"><input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="slug" value="{{ download.slug }}"><label>Reason<textarea name="reason" required minlength="5" maxlength="500"></textarea></label><button type="submit">Send report</button></form></details><p><a href="/downloads">Return to downloads</a></p></article>
{% endblock %}
