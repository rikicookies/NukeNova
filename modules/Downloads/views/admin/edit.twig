{% extends "layouts/default.twig" %}{% block title %}{{ download.id|default(false) ? 'Edit download' : 'Create download' }} — NovaNuke{% endblock %}{% block content %}
<section class="admin-page"><p class="eyebrow">Files</p><h1>{{ download.id|default(false) ? 'Edit download' : 'Create download' }}</h1>{% if error %}<div class="form-errors"><ul><li>{{ error }}</li></ul></div>{% endif %}
<form class="news-editor" method="post" action="/admin/downloads/save" enctype="multipart/form-data"><input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="id" value="{{ download.id|default('') }}">
<div class="form-grid"><label>Name<input name="name" required maxlength="200" value="{{ download.name|default('') }}"></label><label>Slug<input name="slug" required maxlength="200" pattern="[a-z0-9]+(-[a-z0-9]+)*" value="{{ download.slug|default('') }}"></label><label>Category<select name="category_id"><option value="">None</option>{% for category in categories %}<option value="{{ category.id }}" {{ download.category_id|default(null) == category.id ? 'selected' : '' }}>{{ category.parent_name ? category.parent_name ~ ' / ' : '' }}{{ category.name }}</option>{% endfor %}</select></label><label>Version<input name="version" maxlength="50" value="{{ download.version|default('', true) }}"></label><label>Author<input name="author_name" maxlength="150" value="{{ download.author_name|default('', true) }}"></label><label>License<input name="license_name" maxlength="150" value="{{ download.license_name|default('', true) }}"></label></div>
<label class="wide-field">Description<textarea name="description" rows="12" required>{{ download.description|default('') }}</textarea><small>Safe enriched HTML is sanitized when saved.</small></label><label class="wide-field">Requirements<textarea name="requirements" maxlength="2000">{{ download.requirements|default('', true) }}</textarea></label>
<fieldset class="editor-panel"><legend>Source</legend><label><input type="radio" name="source_type" value="local" {{ download.source_type|default('local') == 'local' ? 'checked' : '' }}> Private local file</label><label><input type="radio" name="source_type" value="external" {{ download.source_type|default('local') == 'external' ? 'checked' : '' }}> External URL</label><div class="form-grid"><label>Upload file<input type="file" name="download_file" accept=".zip,.pdf,.txt,.png,.jpg,.jpeg,.webp"><small>ZIP, PDF, TXT, PNG, JPEG or WebP; maximum 50 MB.{% if download.original_name|default(false) %} Current: {{ download.original_name }}{% endif %}</small></label><label>External URL<input type="url" name="external_url" maxlength="2048" value="{{ download.external_url|default('', true) }}"></label></div></fieldset>
<div class="form-grid"><label>Image path<input name="image_path" value="{{ download.image_path|default('', true) }}" placeholder="/uploads/downloads/image.webp"></label><label>Status<select name="status"><option value="draft">Draft</option>{% if can_publish %}<option value="scheduled" {{ download.status|default('draft') == 'scheduled' ? 'selected' : '' }}>Scheduled</option><option value="published" {{ download.status|default('draft') == 'published' ? 'selected' : '' }}>Published</option>{% endif %}</select></label><label>Publication time (UTC)<input type="datetime-local" name="published_at" value="{{ download.published_at|default('', true)|replace({' ': 'T'}) }}"></label></div>
<fieldset class="editor-panel"><legend>Access</legend><label><input type="radio" name="access_type" value="public" {{ download.access_type|default('public') == 'public' ? 'checked' : '' }}> Public</label><label><input type="radio" name="access_type" value="members" {{ download.access_type|default('public') == 'members' ? 'checked' : '' }}> Registered members</label><label><input type="radio" name="access_type" value="roles" {{ download.access_type|default('public') == 'roles' ? 'checked' : '' }}> Selected roles</label><div class="role-checks">{% for role in roles %}<label><input type="checkbox" name="role_ids[]" value="{{ role.id }}" {{ role.id in download.role_ids|default([]) ? 'checked' : '' }}> {{ role.name }}</label>{% endfor %}</div></fieldset>
<label><input type="checkbox" name="is_featured" value="1" {{ download.is_featured|default(0) ? 'checked' : '' }}> Featured download</label><button type="submit">Save download</button></form>
{% if download.id|default(false) %}<form class="delete-block-form" method="post" action="/admin/downloads/{{ download.id }}/delete"><input type="hidden" name="_token" value="{{ csrf_token }}"><label><input type="checkbox" name="confirm_delete" value="1" required> Confirm deletion</label><button class="danger-button" type="submit">Delete download</button></form>{% endif %}<p><a href="/admin/downloads">Return to downloads</a></p></section>
{% endblock %}
