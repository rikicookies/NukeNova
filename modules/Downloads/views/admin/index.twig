{% extends "layouts/default.twig" %}{% block title %}Downloads administration — NovaNuke{% endblock %}{% block content %}
<section class="admin-page">{% include 'components/breadcrumbs.twig' with {items: [{label: 'Admin', url: '/admin'}, {label: 'Downloads'}]} only %}{% include 'components/page-header.twig' with {eyebrow: 'Files', title: 'Downloads', description: 'Manage secure files, external resources, categories and broken-link reports.', actions: [{label: 'Create download', url: '/admin/downloads/new'}, {label: 'View downloads', url: '/downloads'}]} only %}{% if message %}<div class="success-message">{{ message }}</div>{% endif %}{% if error %}<div class="form-errors"><p>{{ error }}</p></div>{% endif %}
{% set audience_labels = {'public':'Public','members':'Registered members','vip':'Active VIP members','roles':'Selected roles'} %}<div class="table-wrap"><table class="admin-table"><thead><tr><th>Download</th><th>Source</th><th>Status</th><th>Access</th><th>Count</th><th>Actions</th></tr></thead><tbody>{% for item in downloads %}<tr><td><strong>{{ item.name }}</strong><small>{{ item.category_name|default('Uncategorized', true) }} · /downloads/{{ item.slug }}</small></td><td>{{ item.source_type }}</td><td><span class="badge {{ item.status == 'published' ? 'badge-active' : '' }}">{{ item.status }}</span></td><td>{{ audience_labels[item.access_type]|default(item.access_type) }}</td><td>{{ item.download_count }}</td><td class="admin-actions-cell">{% include 'components/admin-row-actions.twig' with {label: 'Actions for ' ~ item.name, actions: item.status == 'published' ? [{label: 'Edit', url: '/admin/downloads/' ~ item.id ~ '/edit'}, {label: 'View', url: '/downloads/' ~ item.slug}] : [{label: 'Edit', url: '/admin/downloads/' ~ item.id ~ '/edit'}]} only %}</td></tr>{% else %}{% include 'components/admin-table-empty.twig' with {colspan: 6, title: 'No downloads created', message: 'Create the first downloadable or external resource.', action_url: '/admin/downloads/new', action_label: 'Create download'} only %}{% endfor %}</tbody></table></div>
<form class="editor-panel" method="post" action="/admin/downloads/category"><input type="hidden" name="_token" value="{{ csrf_token }}"><h2>Create category</h2><div class="form-grid"><label>Name<input name="name" required maxlength="120"></label><label>Slug<input name="slug" required pattern="[a-z0-9]+(-[a-z0-9]+)*"></label><label>Parent<select name="parent_id"><option value="">None</option>{% for category in categories %}<option value="{{ category.id }}">{{ category.parent_name ? category.parent_name ~ ' / ' : '' }}{{ category.name }}</option>{% endfor %}</select></label><label>Description<textarea name="description" maxlength="500"></textarea></label></div><button type="submit">Add category</button></form>
<h2>Open reports</h2><div class="table-wrap"><table class="admin-table"><thead><tr><th>Download</th><th>Reporter</th><th>Reason</th><th>Actions</th></tr></thead><tbody>{% for report in reports %}<tr><td>{{ report.name }}<small>#{{ report.download_id }}</small></td><td>{{ report.reporter }}</td><td>{{ report.reason }}<small>{{ report.created_at }}</small></td><td class="admin-actions-cell"><form method="post" action="/admin/download-reports/{{ report.id }}/resolve"><input type="hidden" name="_token" value="{{ csrf_token }}"><button type="submit">Resolve</button></form></td></tr>{% else %}{% include 'components/admin-table-empty.twig' with {colspan: 4, title: 'No open reports', message: 'Broken-download reports will appear here.'} only %}{% endfor %}</tbody></table></div></section>
{% endblock %}
