{% extends "layouts/default.twig" %}{% block title %}Downloads administration — NovaNuke{% endblock %}{% block content %}
<section class="admin-page"><p class="eyebrow">Files</p><h1>Downloads</h1><p>Manage secure files, external resources, categories and broken-link reports.</p>{% if message %}<div class="success-message">{{ message }}</div>{% endif %}{% if error %}<div class="form-errors"><p>{{ error }}</p></div>{% endif %}<p><a class="install-button" href="/admin/downloads/new">Create download</a></p>
<div class="table-wrap"><table class="admin-table"><thead><tr><th>Download</th><th>Source</th><th>Status</th><th>Access</th><th>Count</th><th></th></tr></thead><tbody>{% for item in downloads %}<tr><td><strong>{{ item.name }}</strong><small>{{ item.category_name|default('Uncategorized', true) }} · /downloads/{{ item.slug }}</small></td><td>{{ item.source_type }}</td><td><span class="badge {{ item.status == 'published' ? 'badge-active' : '' }}">{{ item.status }}</span></td><td>{{ item.access_type }}</td><td>{{ item.download_count }}</td><td><a href="/admin/downloads/{{ item.id }}/edit">Edit</a></td></tr>{% else %}<tr><td colspan="6">No downloads created.</td></tr>{% endfor %}</tbody></table></div>
<form class="editor-panel" method="post" action="/admin/downloads/category"><input type="hidden" name="_token" value="{{ csrf_token }}"><h2>Create category</h2><div class="form-grid"><label>Name<input name="name" required maxlength="120"></label><label>Slug<input name="slug" required pattern="[a-z0-9]+(-[a-z0-9]+)*"></label><label>Parent<select name="parent_id"><option value="">None</option>{% for category in categories %}<option value="{{ category.id }}">{{ category.parent_name ? category.parent_name ~ ' / ' : '' }}{{ category.name }}</option>{% endfor %}</select></label><label>Description<textarea name="description" maxlength="500"></textarea></label></div><button type="submit">Add category</button></form>
<h2>Open reports</h2><div class="table-wrap"><table class="admin-table"><thead><tr><th>Download</th><th>Reporter</th><th>Reason</th><th></th></tr></thead><tbody>{% for report in reports %}<tr><td>{{ report.name }}<small>#{{ report.download_id }}</small></td><td>{{ report.reporter }}</td><td>{{ report.reason }}<small>{{ report.created_at }}</small></td><td><form method="post" action="/admin/download-reports/{{ report.id }}/resolve"><input type="hidden" name="_token" value="{{ csrf_token }}"><button type="submit">Resolve</button></form></td></tr>{% else %}<tr><td colspan="4">No open reports.</td></tr>{% endfor %}</tbody></table></div><p><a href="/admin">Return to dashboard</a></p></section>
{% endblock %}
