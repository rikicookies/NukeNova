{% extends "layouts/default.twig" %}{% block title %}{{ link.title }} — Recommended links{% endblock %}{% block content %}
<article class="link-detail">
{% include 'components/breadcrumbs.twig' with {items: [{label: 'Recommended links', url: '/links'}, {label: link.title}]} only %}
{% include 'components/content-actions.twig' with {edit_url: edit_url|default(null), delete_url: delete_url|default(null), csrf_token: content_csrf_token|default(null), return_to: delete_return_to|default(null)} only %}
<p class="eyebrow">{{ link.category_name|default('Recommended link',true) }}</p><h1>{{ link.title }}</h1>{% if message %}<p class="alert alert-success">{{ message }}</p>{% endif %}{% if error %}<p class="alert alert-error">{{ error }}</p>{% endif %}{% if link.image_path %}<img src="{{ link.image_path }}" alt="">{% endif %}<div class="article-content">{{ link.description_html }}</div><p><a class="download-button" href="/links/{{ link.slug }}/visit" target="_blank" rel="noopener noreferrer nofollow external">Visit website</a></p><small>{{ link.visit_count }} recorded visits</small><details class="report-download"><summary>Report broken link</summary><form method="post" action="/links/{{ link.id }}/report"><input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="slug" value="{{ link.slug }}"><label>Reason<textarea name="reason" required minlength="5" maxlength="500"></textarea></label><button>Submit report</button></form></details>
</article>
{% endblock %}
