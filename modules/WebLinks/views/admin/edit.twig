{% extends "layouts/default.twig" %}{% block title %}Edit recommended link — NovaNuke{% endblock %}{% block content %}<section class="admin-page"><p class="eyebrow">Web Links</p><h1>{{ link.id|default(null) ? 'Edit link' : 'Create link' }}</h1>{% if error %}<p class="alert alert-error">{{ error }}</p>{% endif %}<form class="link-editor" method="post" action="/admin/web-links/save"><input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="id" value="{{ link.id|default('') }}"><div class="form-grid"><label>Title<input name="title" required maxlength="200" value="{{ link.title|default('') }}"></label><label>Slug<input name="slug" required pattern="[a-z0-9]+(-[a-z0-9]+)*" value="{{ link.slug|default('') }}"></label><label>URL<input type="url" name="url" required maxlength="2048" value="{{ link.url|default('') }}"></label><label>Category<select name="category_id"><option value="">None</option>{% for category in categories %}<option value="{{ category.id }}" {{ link.category_id|default(null) == category.id ? 'selected' : '' }}>{{ category.name }}</option>{% endfor %}</select></label><label>Status<select name="status"><option value="pending">Pending</option><option value="published" {{ link.status|default('') == 'published' ? 'selected' : '' }}>Published</option><option value="rejected" {{ link.status|default('') == 'rejected' ? 'selected' : '' }}>Rejected</option></select></label><label>Image path<input name="image_path" maxlength="255" value="{{ link.image_path|default('') }}"></label></div><label class="wide-field">Description<textarea name="description" required rows="8">{{ link.description|default('') }}</textarea></label><label><input type="checkbox" name="is_featured" value="1" {{ link.is_featured|default(false) ? 'checked' : '' }}> Featured</label><button>Save link</button></form><p><a href="/admin/web-links">Return to Web Links</a></p></section>{% endblock %}
