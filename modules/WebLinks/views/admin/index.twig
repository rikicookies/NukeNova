{% extends "layouts/default.twig" %}{% block title %}Web Links administration — NovaNuke{% endblock %}{% block content %}<section class="admin-page"><p class="eyebrow">Directory</p><h1>Web Links</h1>{% if message %}<p class="alert alert-success">{{ message }}</p>{% endif %}{% if error %}<p class="alert alert-error">{{ error }}</p>{% endif %}<p><a class="install-button" href="/admin/web-links/new">Create link</a></p><div class="table-wrap"><table class="admin-table"><thead><tr><th>Link</th><th>Status</th><th>Visits</th><th>Submitted by</th><th></th></tr></thead><tbody>{% for item in links %}<tr><td><strong>{{ item.title }}</strong><small>{{ item.category_name|default('Uncategorized',true) }}</small></td><td>{{ item.status }}{% if item.is_featured %} · Featured{% endif %}</td><td>{{ item.visit_count }}</td><td>{{ item.submitter }}</td><td><a href="/admin/web-links/{{ item.id }}/edit">Review/Edit</a><form class="inline-form" method="post" action="/admin/web-links/{{ item.id }}/delete"><input type="hidden" name="_token" value="{{ csrf_token }}"><label><input type="checkbox" name="confirm_delete" value="1" required> Confirm</label><button>Delete</button></form></td></tr>{% else %}<tr><td colspan="5">No links.</td></tr>{% endfor %}</tbody></table></div><form class="editor-panel" method="post" action="/admin/web-links/category"><input type="hidden" name="_token" value="{{ csrf_token }}"><h2>Create category</h2><div class="form-grid"><label>Name<input name="name" required maxlength="120"></label><label>Slug<input name="slug" required pattern="[a-z0-9]+(-[a-z0-9]+)*"></label><label>Description<textarea name="description" maxlength="500"></textarea></label></div><button>Add category</button></form><h2>Broken-link reports</h2><div class="table-wrap"><table class="admin-table"><thead><tr><th>Link</th><th>Reporter</th><th>Reason</th><th></th></tr></thead><tbody>{% for item in reports %}<tr><td>{{ item.title }}</td><td>{{ item.reporter }}</td><td>{{ item.reason }}<small>{{ item.created_at }}</small></td><td><form method="post" action="/admin/web-link-reports/{{ item.id }}/resolve"><input type="hidden" name="_token" value="{{ csrf_token }}"><button>Resolve</button></form></td></tr>{% else %}<tr><td colspan="4">No open reports.</td></tr>{% endfor %}</tbody></table></div></section>{% endblock %}
