{% extends "layouts/default.twig" %}
{% block title %}Web Links administration — NovaNuke{% endblock %}
{% block content %}
<section class="admin-page">
    {% include 'components/breadcrumbs.twig' with {items: [{label: 'Admin', url: '/admin'}, {label: 'Web Links'}]} only %}
    {% include 'components/page-header.twig' with {eyebrow: 'Directory', title: 'Web Links', description: 'Review recommended links, submissions, categories and broken-link reports.', actions: [{label: 'Create link', url: '/admin/web-links/new'}, {label: 'View links', url: '/links'}]} only %}
    {% if message %}<p class="alert alert-success">{{ message }}</p>{% endif %}
    {% if error %}<p class="alert alert-error">{{ error }}</p>{% endif %}
    {% set audience_labels = {'public':'Public','member':'Registered members','vip':'Active VIP members'} %}
    <div class="table-wrap"><table class="admin-table">
        <thead><tr><th>Link</th><th>Status</th><th>Audience</th><th>Visits</th><th>Submitted by</th><th>Actions</th></tr></thead>
        <tbody>{% for item in links %}<tr><td><strong>{{ item.title }}</strong><small>{{ item.category_name|default('Uncategorized',true) }}</small></td><td>{{ item.status }}{% if item.is_featured %} · Featured{% endif %}</td><td>{{ audience_labels[item.audience]|default(item.audience) }}</td><td>{{ item.visit_count }}</td><td>{{ item.submitter }}</td><td class="admin-actions-cell">{% include 'components/admin-row-actions.twig' with {label: 'Actions for ' ~ item.title, actions: item.status == 'published' ? [{label: 'Edit', url: '/admin/web-links/' ~ item.id ~ '/edit'}, {label: 'View', url: '/links/' ~ item.slug}] : [{label: 'Review/Edit', url: '/admin/web-links/' ~ item.id ~ '/edit'}]} only %}<form class="inline-form" method="post" action="/admin/web-links/{{ item.id }}/delete"><input type="hidden" name="_token" value="{{ csrf_token }}"><label><input type="checkbox" name="confirm_delete" value="1" required> Confirm</label><button>Delete</button></form></td></tr>{% else %}{% include 'components/admin-table-empty.twig' with {colspan: 6, title: 'No links', message: 'Create a link or wait for a member submission.', action_url: '/admin/web-links/new', action_label: 'Create link'} only %}{% endfor %}</tbody>
    </table></div>
    <form class="editor-panel" method="post" action="/admin/web-links/category"><input type="hidden" name="_token" value="{{ csrf_token }}"><h2>Create category</h2><div class="form-grid"><label>Name<input name="name" required maxlength="120"></label><label>Slug<input name="slug" required pattern="[a-z0-9]+(-[a-z0-9]+)*"></label><label>Description<textarea name="description" maxlength="500"></textarea></label></div><button>Add category</button></form>
    <h2>Broken-link reports</h2><div class="table-wrap"><table class="admin-table"><thead><tr><th>Link</th><th>Reporter</th><th>Reason</th><th>Actions</th></tr></thead><tbody>{% for item in reports %}<tr><td>{{ item.title }}</td><td>{{ item.reporter }}</td><td>{{ item.reason }}<small>{{ item.created_at }}</small></td><td class="admin-actions-cell"><form method="post" action="/admin/web-link-reports/{{ item.id }}/resolve"><input type="hidden" name="_token" value="{{ csrf_token }}"><button>Resolve</button></form></td></tr>{% else %}{% include 'components/admin-table-empty.twig' with {colspan: 4, title: 'No open reports', message: 'Broken-link reports will appear here.'} only %}{% endfor %}</tbody></table></div>
</section>
{% endblock %}
