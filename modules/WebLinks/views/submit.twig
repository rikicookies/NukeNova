{% extends "layouts/default.twig" %}{% block title %}Submit a link — NovaNuke{% endblock %}{% block content %}<section class="links-page"><p class="eyebrow">Community submission</p><h1>Submit a link</h1><p>Submissions remain pending until an administrator approves them.</p>{% if error %}<p class="alert alert-error">{{ error }}</p>{% endif %}<form class="link-editor" method="post" action="/links/submit"><input type="hidden" name="_token" value="{{ csrf_token }}"><div class="form-grid"><label>Title<input name="title" required maxlength="200" value="{{ link.title|default('') }}"></label><label>Slug<input name="slug" required maxlength="200" pattern="[a-z0-9]+(-[a-z0-9]+)*" value="{{ link.slug|default('') }}"></label><label>URL<input type="url" name="url" required maxlength="2048" value="{{ link.url|default('') }}"></label><label>Category<select name="category_id"><option value="">None</option>{% for category in categories %}<option value="{{ category.id }}" {{ link.category_id|default(null) == category.id ? 'selected' : '' }}>{{ category.name }}</option>{% endfor %}</select></label><label>Image path<input name="image_path" maxlength="255" placeholder="/uploads/images/example.webp" value="{{ link.image_path|default('') }}"></label></div><label class="wide-field">Description<textarea name="description" required rows="7">{{ link.description|default('') }}</textarea></label><button>Submit for review</button></form></section>{% endblock %}
