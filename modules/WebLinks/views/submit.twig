{% extends "layouts/default.twig" %}
{% block title %}Submit a link — NovaNuke{% endblock %}
{% block content %}
<section class="links-page module-page">
    {% include 'components/breadcrumbs.twig' with {items: [{label: 'Home', url: '/'}, {label: 'Recommended links', url: '/links'}, {label: 'Submit a link'}]} only %}
    {% include 'components/page-header.twig' with {eyebrow: 'Community submission', title: 'Submit a link', description: 'Recommend a useful website. Submissions remain pending until an administrator approves them.'} only %}
    {% if error %}<p class="alert alert-error">{{ error }}</p>{% endif %}
    <form class="link-editor form-surface" method="post" action="/links/submit"><input type="hidden" name="_token" value="{{ csrf_token }}"><div class="form-grid"><label>Title<input name="title" required maxlength="200" value="{{ link.title|default('') }}"></label><label>Slug<input name="slug" required maxlength="200" pattern="[a-z0-9]+(-[a-z0-9]+)*" value="{{ link.slug|default('') }}"></label><label>URL<input type="url" name="url" required maxlength="2048" value="{{ link.url|default('') }}"></label><label>Category<select name="category_id"><option value="">None</option>{% for category in categories %}<option value="{{ category.id }}" {{ link.category_id|default(null) == category.id ? 'selected' : '' }}>{{ category.name }}</option>{% endfor %}</select></label><label>Image path<input name="image_path" maxlength="255" placeholder="/uploads/images/example.webp" value="{{ link.image_path|default('') }}"></label><label>Content format<select name="description_format"><option value="markdown" {{ link.description_format|default('markdown') == 'markdown' ? 'selected' : '' }}>Markdown</option><option value="html" {{ link.description_format|default('markdown') == 'html' ? 'selected' : '' }}>Sanitized HTML</option></select></label></div><label class="wide-field">Description<textarea name="description" required rows="7">{{ link.description|default('') }}</textarea><small>Both formats are sanitized before display.</small></label><div class="module-action-row"><button class="module-button-primary">Submit for review</button><a class="module-link-button" href="/links">Cancel</a></div></form>
</section>
{% endblock %}
