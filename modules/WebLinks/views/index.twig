{% extends "layouts/default.twig" %}{% block title %}Recommended links — {{ cms_name|default('NovaNuke') }}{% endblock %}{% block content %}<section class="links-page">{% include 'components/breadcrumbs.twig' with {items: [{label: 'Recommended links'}]} only %}{% set header_actions = manage_url ? [{label: 'Manage', url: manage_url}, {label: 'Submit a link', url: '/links/submit'}] : [{label: 'Submit a link', url: '/links/submit'}] %}{% include 'components/page-header.twig' with {eyebrow: 'Directory', title: 'Recommended links', actions: header_actions} only %}<nav class="category-links"><a href="/links">All</a>{% for item in categories %}<a href="/links/category/{{ item.slug }}">{{ item.name }}</a>{% endfor %}</nav><form class="link-filters" method="get"><input name="q" maxlength="100" value="{{ search }}" placeholder="Search links"><select name="order"><option value="new">Newest</option><option value="popular" {{ order == 'popular' ? 'selected' : '' }}>Popular</option><option value="title" {{ order == 'title' ? 'selected' : '' }}>Title</option></select><button>Search</button></form><div class="link-grid">{% for item in result.items %}<article>{% if item.image_path %}<img src="{{ item.image_path }}" alt="">{% endif %}{% if item.is_featured %}<span class="badge badge-active">Featured</span>{% endif %}<h2><a href="/links/{{ item.slug }}">{{ item.title }}</a></h2><p>{{ item.description_text|slice(0,220) }}</p><small>{{ item.category_name|default('Uncategorized',true) }} · {{ item.visit_count }} visits</small></article>{% else %}{% include 'components/empty-state.twig' with {title: 'No links found', message: 'Try another category or remove some filters.', action_url: '/links/submit', action_label: 'Submit a link'} only %}{% endfor %}</div>{% set pagination_url = '?q=' ~ (search|url_encode) ~ '&order=' ~ (order|url_encode) ~ '&page={page}' %}{% include 'components/pagination.twig' with {current_page: result.page, total_pages: result.pages, url_template: pagination_url, label: 'Link pages'} only %}</section>{% endblock %}
