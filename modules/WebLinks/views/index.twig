{% extends "layouts/default.twig" %}{% block title %}Recommended links — {{ cms_name|default('NovaNuke') }}{% endblock %}{% block content %}<section class="links-page"><p class="eyebrow">Directory</p><h1>Recommended links</h1><nav class="category-links"><a href="/links">All</a>{% for item in categories %}<a href="/links/category/{{ item.slug }}">{{ item.name }}</a>{% endfor %}</nav><form class="link-filters" method="get"><input name="q" maxlength="100" value="{{ search }}" placeholder="Search links"><select name="order"><option value="new">Newest</option><option value="popular" {{ order == 'popular' ? 'selected' : '' }}>Popular</option><option value="title" {{ order == 'title' ? 'selected' : '' }}>Title</option></select><button>Search</button></form><p><a href="/links/submit">Submit a link</a></p><div class="link-grid">{% for item in result.items %}<article>{% if item.image_path %}<img src="{{ item.image_path }}" alt="">{% endif %}{% if item.is_featured %}<span class="badge badge-active">Featured</span>{% endif %}<h2><a href="/links/{{ item.slug }}">{{ item.title }}</a></h2><p>{{ item.description|striptags|slice(0,220) }}</p><small>{{ item.category_name|default('Uncategorized',true) }} · {{ item.visit_count }} visits</small></article>{% else %}<p>No links found.</p>{% endfor %}</div>{% if result.pages > 1 %}<nav class="pagination">{% for page in 1..result.pages %}<a class="{{ page == result.page ? 'current' : '' }}" href="?q={{ search|url_encode }}&order={{ order }}&page={{ page }}">{{ page }}</a>{% endfor %}</nav>{% endif %}</section>{% endblock %}
