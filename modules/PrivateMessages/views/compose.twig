{% extends "layouts/default.twig" %}{% block title %}New message — NovaNuke{% endblock %}{% block content %}<section class="messages-page"><p class="eyebrow">Account</p><h1>New message</h1>{% include "@private-messages/_nav.twig" %}{% if error %}<p class="alert alert-error">{{ error }}</p>{% endif %}<form class="message-form" method="post" action="/messages"><input type="hidden" name="_token" value="{{ csrf_token }}"><label>Recipient username<input name="recipient" required maxlength="32" value="{{ recipient|default('') }}"></label><label>Subject<input name="subject" required minlength="2" maxlength="200" value="{{ subject|default('') }}"></label><label>Message<textarea name="body" required minlength="2" maxlength="5000">{{ body|default('') }}</textarea></label><button type="submit">Send message</button></form></section>{% endblock %}
