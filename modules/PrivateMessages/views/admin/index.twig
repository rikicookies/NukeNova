{% extends "layouts/default.twig" %}
{% block title %}Private message reports — NovaNuke{% endblock %}
{% block content %}
<section class="admin-page">
    {% include 'components/breadcrumbs.twig' with {items: [{label: 'Admin', url: '/admin'}, {label: 'Private message reports'}]} only %}
    {% include 'components/page-header.twig' with {eyebrow: 'Moderation', title: 'Private message reports', description: 'Review and resolve open reports without exposing unrelated private-message content.'} only %}
    {% if message %}<p class="alert alert-success">{{ message }}</p>{% endif %}{% if error %}<p class="alert alert-error">{{ error }}</p>{% endif %}
    <div class="table-wrap"><table class="admin-table"><thead><tr><th>Users</th><th>Message excerpt</th><th>Reason</th><th>Action</th></tr></thead><tbody>
    {% for item in reports %}<tr><td><strong>{{ item.sender }} → {{ item.reporter }}</strong></td><td><span class="comment-preview">{{ item.body|slice(0,180) }}</span></td><td>{{ item.reason }}</td><td><form method="post" action="/admin/private-message-reports/{{ item.id }}/resolve"><input type="hidden" name="_token" value="{{ csrf_token }}"><button>Resolve</button></form></td></tr>
    {% else %}{% include 'components/admin-table-empty.twig' with {colspan: 4, title: 'No open reports', message: 'Reported private messages requiring moderation will appear here.'} only %}{% endfor %}
    </tbody></table></div>
</section>
{% endblock %}
