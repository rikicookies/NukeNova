{% extends "layouts/default.twig" %}{% block title %}Sent messages — NovaNuke{% endblock %}{% block content %}<section class="messages-page"><p class="eyebrow">Account</p><h1>Sent</h1>{% include "@private-messages/_nav.twig" %}<div class="message-list">{% for item in messages %}<a class="message-row" href="/messages/{{ item.conversation_id }}"><strong>{{ item.subject }}</strong><span>To {{ item.recipient }}</span><small>{{ item.body|slice(0,120) }} · {{ item.created_at }}</small></a>{% else %}<p>No sent messages.</p>{% endfor %}</div></section>{% endblock %}
