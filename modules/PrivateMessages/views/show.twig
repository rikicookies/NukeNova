{% extends "layouts/default.twig" %}
{% block title %}{{ thread.subject }} — Messages{% endblock %}
{% block content %}
<section class="messages-page module-page">
    {% include 'components/breadcrumbs.twig' with {items: [{label: 'Home', url: '/'}, {label: 'Messages', url: '/messages'}, {label: thread.subject}]} only %}
    {% include 'components/page-header.twig' with {eyebrow: 'Conversation with ' ~ thread.other.username, title: thread.subject, description: 'Private conversation thread.'} only %}
    {% include "@private-messages/_nav.twig" %}
    {% if message %}<p class="alert alert-success">{{ message }}</p>{% endif %}{% if error %}<p class="alert alert-error">{{ error }}</p>{% endif %}
    <div class="conversation surface-list">
        {% for item in thread.messages %}
        <article class="private-message surface-card">
            <header class="module-section-heading"><div><strong>{{ item.username }}</strong><div class="surface-card-meta"><span>{{ item.created_at }}</span></div></div></header>
            <div class="message-body">{{ item.body_html }}</div>
            {% if item.sender_id == thread.other.id %}<details><summary>Report abuse</summary><form class="form-surface" method="post" action="/messages/{{ item.id }}/report"><input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="conversation_id" value="{{ thread.id }}"><label>Reason<textarea name="reason" required minlength="5" maxlength="500"></textarea></label><button>Report</button></form></details>{% endif %}
        </article>
        {% endfor %}
    </div>
    <section class="module-section"><div class="module-section-heading"><div><h2>Reply</h2><p>Markdown and sanitized HTML are supported.</p></div></div><form class="message-form" method="post" action="/messages/{{ thread.id }}/reply"><input type="hidden" name="_token" value="{{ csrf_token }}"><label>Format<select name="body_format"><option value="markdown">Markdown</option><option value="html">HTML (sanitized)</option></select></label><label>Reply<textarea name="body" required minlength="2" maxlength="5000" rows="8"></textarea></label><button class="module-button-primary">Send reply</button></form></section>
    <section class="module-section"><div class="module-section-heading"><div><h2>Conversation actions</h2><p>Blocking affects future contact; removing the conversation only affects your view.</p></div></div><div class="module-action-row"><form method="post" action="/messages/users/{{ thread.other.id }}/block"><input type="hidden" name="_token" value="{{ csrf_token }}"><button>Block {{ thread.other.username }}</button></form><form method="post" action="/messages/{{ thread.id }}/delete"><input type="hidden" name="_token" value="{{ csrf_token }}"><button class="danger-button">Remove conversation</button></form></div></section>
</section>
{% endblock %}
