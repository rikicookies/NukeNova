{% extends "layouts/default.twig" %}{% block title %}{{ thread.subject }} — Messages{% endblock %}{% block content %}<section class="messages-page"><p class="eyebrow">Conversation with {{ thread.other.username }}</p><h1>{{ thread.subject }}</h1>{% include "@private-messages/_nav.twig" %}{% if message %}<p class="alert alert-success">{{ message }}</p>{% endif %}{% if error %}<p class="alert alert-error">{{ error }}</p>{% endif %}<div class="conversation">{% for item in thread.messages %}<article class="private-message"><header><strong>{{ item.username }}</strong><small>{{ item.created_at }}</small></header><p>{{ item.body|nl2br }}</p>{% if item.sender_id != thread.other.id %}{% else %}<details><summary>Report abuse</summary><form method="post" action="/messages/{{ item.id }}/report"><input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="conversation_id" value="{{ thread.id }}"><textarea name="reason" required minlength="5" maxlength="500"></textarea><button>Report</button></form></details>{% endif %}</article>{% endfor %}</div><form class="message-form" method="post" action="/messages/{{ thread.id }}/reply"><input type="hidden" name="_token" value="{{ csrf_token }}"><label>Reply<textarea name="body" required minlength="2" maxlength="5000"></textarea></label><button>Send reply</button></form><div class="message-actions"><form method="post" action="/messages/users/{{ thread.other.id }}/block"><input type="hidden" name="_token" value="{{ csrf_token }}"><button>Block {{ thread.other.username }}</button></form><form method="post" action="/messages/{{ thread.id }}/delete"><input type="hidden" name="_token" value="{{ csrf_token }}"><button>Remove conversation</button></form></div></section>{% endblock %}
