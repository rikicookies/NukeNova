{% extends "layouts/default.twig" %}{% block title %}Messages — {{ cms_name|default('NovaNuke') }}{% endblock %}{% block content %}<section class="messages-page"><p class="eyebrow">Account</p><h1>Messages</h1>{% include "@private-messages/_nav.twig" %}{% if message %}<p class="alert alert-success">{{ message }}</p>{% endif %}{% if error %}<p class="alert alert-error">{{ error }}</p>{% endif %}<div class="message-list">{% for item in conversations %}<a class="message-row {{ item.unread ? 'unread' : '' }}" href="/messages/{{ item.id }}"><strong>{{ item.subject }}</strong><span>{{ item.other_username }}</span><small>{{ item.last_message_at }}</small></a>{% else %}<p>Your inbox is empty.</p>{% endfor %}</div></section>{% endblock %}
