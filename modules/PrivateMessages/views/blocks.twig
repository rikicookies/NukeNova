{% extends "layouts/default.twig" %}{% block title %}Blocked users — Messages{% endblock %}{% block content %}<section class="messages-page"><p class="eyebrow">Account</p><h1>Blocked users</h1>{% include "@private-messages/_nav.twig" %}{% if message %}<p class="alert alert-success">{{ message }}</p>{% endif %}<div class="message-list">{% for item in blocks %}<div class="message-row"><strong>{{ item.username }}</strong><small>{{ item.created_at }}</small><form method="post" action="/messages/users/{{ item.id }}/unblock"><input type="hidden" name="_token" value="{{ csrf_token }}"><button>Unblock</button></form></div>{% else %}<p>You have not blocked anyone.</p>{% endfor %}</div></section>{% endblock %}
