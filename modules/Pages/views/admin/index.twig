{% extends "layouts/default.twig" %}{% block title %}Pages administration — NovaNuke{% endblock %}{% block content %}
<section class="admin-page">{% include 'components/breadcrumbs.twig' with {items: [{label: 'Admin', url: '/admin'}, {label: 'Pages'}]} only %}{% include 'components/page-header.twig' with {eyebrow: 'Content', title: 'Pages', description: 'Create informational content with publication, hierarchy and audience controls.', actions: [{label: 'Create page', url: '/admin/pages/new'}, {label: 'View pages', url: '/pages'}]} only %}{% if message %}<div class="success-message">{{ message }}</div>{% endif %}
{% set audience_labels = {'public':'Public','members':'Registered members','vip':'Active VIP members','roles':'Selected roles'} %}<div class="table-wrap"><table class="admin-table"><thead><tr><th>Page</th><th>Status</th><th>Access</th><th>Template</th><th>Publication</th><th>Actions</th></tr></thead><tbody>{% for page in pages %}<tr><td><strong>{{ page.title }}</strong><small>/pages/{{ page.slug }} · {{ page.username }}{% if page.parent_title %} · child of {{ page.parent_title }}{% endif %}</small></td><td><span class="badge {{ page.status == 'published' ? 'badge-active' : '' }}">{{ page.status }}</span></td><td>{{ audience_labels[page.access_type]|default(page.access_type) }}</td><td>{{ page.template }}</td><td>{{ page.published_at|default('—', true) }}</td><td class="admin-actions-cell">{% include 'components/admin-row-actions.twig' with {label: 'Actions for ' ~ page.title, actions: page.status == 'published' ? [{label: 'Edit', url: '/admin/pages/' ~ page.id ~ '/edit'}, {label: 'View', url: '/pages/' ~ page.slug}] : [{label: 'Edit', url: '/admin/pages/' ~ page.id ~ '/edit'}]} only %}</td></tr>{% else %}{% include 'components/admin-table-empty.twig' with {colspan: 6, title: 'No pages created', message: 'Create the first page for your site.', action_url: '/admin/pages/new', action_label: 'Create page'} only %}{% endfor %}</tbody></table></div></section>
{% endblock %}
