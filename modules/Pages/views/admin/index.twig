{% extends "layouts/default.twig" %}{% block title %}Pages administration — NovaNuke{% endblock %}{% block content %}
<section class="admin-page"><p class="eyebrow">Content</p><h1>Pages</h1><p>Create informational content with publication, hierarchy and audience controls.</p>{% if message %}<div class="success-message">{{ message }}</div>{% endif %}<p><a class="install-button" href="/admin/pages/new">Create page</a></p>
<div class="table-wrap"><table class="admin-table"><thead><tr><th>Page</th><th>Status</th><th>Access</th><th>Template</th><th>Publication</th><th></th></tr></thead><tbody>{% for page in pages %}<tr><td><strong>{{ page.title }}</strong><small>/pages/{{ page.slug }} · {{ page.username }}{% if page.parent_title %} · child of {{ page.parent_title }}{% endif %}</small></td><td><span class="badge {{ page.status == 'published' ? 'badge-active' : '' }}">{{ page.status }}</span></td><td>{{ page.access_type }}</td><td>{{ page.template }}</td><td>{{ page.published_at|default('—', true) }}</td><td><a href="/admin/pages/{{ page.id }}/edit">Edit</a></td></tr>{% else %}<tr><td colspan="6">No pages created.</td></tr>{% endfor %}</tbody></table></div><p><a class="auth-link" href="/admin">Return to dashboard</a></p></section>
{% endblock %}
