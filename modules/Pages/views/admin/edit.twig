{% extends "layouts/default.twig" %}{% block title %}{{ page.id|default(false) ? 'Edit page' : 'Create page' }} — NovaNuke{% endblock %}{% block content %}
<section class="admin-page"><p class="eyebrow">Content</p><h1>{{ page.id|default(false) ? 'Edit page' : 'Create page' }}</h1>{% if error %}<div class="form-errors"><ul><li>{{ error }}</li></ul></div>{% endif %}
<form class="news-editor" method="post" action="/admin/pages/save"><input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="id" value="{{ page.id|default('') }}">
<div class="form-grid"><label>Title<input name="title" required maxlength="200" value="{{ page.title|default('') }}"></label><label>Slug<input name="slug" required maxlength="200" pattern="[a-z0-9]+(-[a-z0-9]+)*" value="{{ page.slug|default('') }}"></label><label>Parent page<select name="parent_id"><option value="">None</option>{% for parent in parents %}<option value="{{ parent.id }}" {{ page.parent_id|default(null) == parent.id ? 'selected' : '' }}>{{ parent.title }}</option>{% endfor %}</select></label><label>Template<select name="template"><option value="default">Default</option><option value="landing" {{ page.template|default('default') == 'landing' ? 'selected' : '' }}>Landing</option></select></label></div>
<label class="wide-field">Content<textarea name="content" rows="16" required>{{ page.content|default('') }}</textarea><small>Safe enriched HTML is allowed and sanitized when saved.</small></label>
<div class="form-grid"><label>Page image path<input name="image_path" list="page-media-images" value="{{ page.image_path|default('', true) }}" placeholder="/uploads/media/..."><small>{% if media_available %}Choose an uploaded image or <a href="/admin/media">open Media</a>.{% else %}Activate Media for managed images.{% endif %}</small></label><label>Menu label<input name="menu_title" maxlength="120" value="{{ page.menu_title|default('', true) }}" placeholder="Optional shorter label"></label><label>Status<select name="status"><option value="draft">Draft</option>{% if can_publish %}<option value="scheduled" {{ page.status|default('draft') == 'scheduled' ? 'selected' : '' }}>Scheduled</option><option value="published" {{ page.status|default('draft') == 'published' ? 'selected' : '' }}>Published</option>{% endif %}</select></label><label>Publication time (UTC)<input type="datetime-local" name="published_at" value="{{ page.published_at|default('', true)|replace({' ': 'T'}) }}"></label><label>SEO title<input name="seo_title" maxlength="200" value="{{ page.seo_title|default('', true) }}"></label><label>SEO description<textarea name="seo_description" maxlength="320">{{ page.seo_description|default('', true) }}</textarea></label></div>{% if media_available %}<datalist id="page-media-images">{% for image in media_images %}<option value="{{ image.public_path }}">{{ image.title|default(image.original_name,true) }}</option>{% endfor %}</datalist>{% endif %}
<fieldset class="editor-panel"><legend>Access</legend><label><input type="radio" name="access_type" value="public" {{ page.access_type|default('public') == 'public' ? 'checked' : '' }}> Public</label><label><input type="radio" name="access_type" value="members" {{ page.access_type|default('public') == 'members' ? 'checked' : '' }}> Any registered member</label><label><input type="radio" name="access_type" value="roles" {{ page.access_type|default('public') == 'roles' ? 'checked' : '' }}> Selected roles</label><div class="role-checks">{% for role in roles %}<label><input type="checkbox" name="role_ids[]" value="{{ role.id }}" {{ role.id in page.role_ids|default([]) ? 'checked' : '' }}> {{ role.name }}</label>{% endfor %}</div></fieldset>
<div class="inline-checks"><label><input type="checkbox" name="show_in_directory" value="1" {{ page.show_in_directory|default(0) ? 'checked' : '' }}> Show in page directory</label><label><input type="checkbox" name="comments_enabled" value="1" {{ page.comments_enabled|default(0) ? 'checked' : '' }}> Allow comments</label></div><button type="submit">Save page</button></form>
{% if page.id|default(false) %}<form class="delete-block-form" method="post" action="/admin/pages/{{ page.id }}/delete"><input type="hidden" name="_token" value="{{ csrf_token }}"><label><input type="checkbox" name="confirm_delete" value="1" required> Confirm deletion</label><button class="danger-button" type="submit">Delete page</button></form>{% endif %}<p><a href="/admin/pages">Return to pages</a></p></section>
{% endblock %}
