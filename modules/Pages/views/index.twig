{% extends "layouts/default.twig" %}{% block title %}Pages — NovaNuke{% endblock %}{% block content %}
<section class="pages-directory">{% include 'components/breadcrumbs.twig' with {items: [{label: 'Pages'}]} only %}{% set header_actions = manage_url ? [{label: 'Manage', url: manage_url}] : [] %}{% include 'components/page-header.twig' with {eyebrow: 'Explore', title: 'Pages', actions: header_actions} only %}<div class="page-directory-grid">{% for page in pages %}<article><h2><a href="/pages/{{ page.slug }}">{{ page.menu_title|default(page.title, true) }}</a></h2>{% if page.access_type != 'public' %}<span class="badge">{{ page.access_type }}</span>{% endif %}</article>{% else %}{% include 'components/empty-state.twig' with {title: 'No pages yet', message: 'Published pages available to your account will appear here.'} only %}{% endfor %}</div></section>
{% endblock %}
