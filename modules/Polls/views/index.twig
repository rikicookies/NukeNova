{% extends "layouts/default.twig" %}{% block title %}Polls — {{ cms_name|default('NovaNuke') }}{% endblock %}{% block content %}<section class="polls-page"><p class="eyebrow">Community</p><h1>Polls</h1><div class="poll-list">{% for poll in polls %}<article><span class="badge {{ poll.status == 'active' ? 'badge-active' : '' }}">{{ poll.status }}</span><h2><a href="/polls/{{ poll.id }}">{{ poll.question }}</a></h2><small>{{ poll.vote_count }} votes{% if poll.ends_at %} · Ends {{ poll.ends_at }} UTC{% endif %}</small></article>{% else %}<p>No polls are available.</p>{% endfor %}</div></section>{% endblock %}
