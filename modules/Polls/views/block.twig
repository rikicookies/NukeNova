<div class="poll-block"><strong>{{ poll.question|default('Poll') }}</strong>{% if poll.accepting|default(false) and not has_voted|default(false) %}<form method="post" action="/polls/{{ poll.id|default(0) }}/vote"><input type="hidden" name="_token" value="{{ csrf_token|default('') }}"><input type="hidden" name="_return" value="{{ return_path|default('/') }}">{% for option in poll.options|default([]) %}<label><input type="{{ poll.allow_multiple|default(false) ? 'checkbox' : 'radio' }}" name="options[]" value="{{ option.id|default(0) }}"> {{ option.label|default('Option') }}</label>{% endfor %}<button type="submit">Vote</button></form>{% else %}<p>{{ has_voted|default(false) ? 'Thanks for voting.' : 'Voting is closed.' }}</p>{% endif %}<a href="/polls/{{ poll.id|default(0) }}">View results</a></div>
