<div class="poll-block"><strong>{{ poll.question }}</strong>{% if poll.accepting and not has_voted %}<form method="post" action="/polls/{{ poll.id }}/vote"><input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="_return" value="{{ return_path }}">{% for option in poll.options %}<label><input type="{{ poll.allow_multiple ? 'checkbox' : 'radio' }}" name="options[]" value="{{ option.id }}"> {{ option.label }}</label>{% endfor %}<button type="submit">Vote</button></form>{% else %}<p>{{ has_voted ? 'Thanks for voting.' : 'Voting is closed.' }}</p>{% endif %}<a href="/polls/{{ poll.id }}">View results</a></div>
