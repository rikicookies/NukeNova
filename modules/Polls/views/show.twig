{% extends "layouts/default.twig" %}{% block title %}{{ poll.question }} — Polls{% endblock %}{% block content %}<section class="polls-page poll-detail"><p class="eyebrow">Poll</p><h1>{{ poll.question }}</h1>{% if message %}<p class="alert alert-success">{{ message }}</p>{% endif %}{% if error %}<p class="alert alert-error">{{ error }}</p>{% endif %}{% if poll.accepting and not has_voted %}<form class="poll-form" method="post" action="/polls/{{ poll.id }}/vote"><input type="hidden" name="_token" value="{{ csrf_token }}">{% for option in poll.options %}<label><input type="{{ poll.allow_multiple ? 'checkbox' : 'radio' }}" name="options[]" value="{{ option.id }}"> {{ option.label }}</label>{% endfor %}<small>{{ poll.allow_multiple ? 'Choose up to ' ~ poll.max_selections ~ ' options.' : 'Choose one option.' }}</small><button type="submit">Vote</button></form>{% else %}<p>{{ has_voted ? 'You already voted in this poll.' : 'This poll is closed.' }}</p>{% endif %}<h2>Results</h2><div class="poll-results">{% for option in poll.options %}{% set percent = poll.total_votes > 0 ? (option.votes / poll.total_votes * 100) : 0 %}<div><span>{{ option.label }} — {{ option.votes }} ({{ percent|round }}%)</span><progress max="100" value="{{ percent }}"></progress></div>{% endfor %}</div><p><strong>{{ poll.total_votes }}</strong> total voters.</p><p><a href="/polls">All polls</a></p></section>{% endblock %}
