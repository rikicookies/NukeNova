{% extends "layouts/default.twig" %}
{% block title %}Polls administration — NovaNuke{% endblock %}
{% block content %}
<section class="admin-page">
    {% include 'components/breadcrumbs.twig' with {items: [{label: 'Admin', url: '/admin'}, {label: 'Polls'}]} only %}
    {% include 'components/page-header.twig' with {eyebrow: 'Engagement', title: 'Polls', description: 'Create, schedule and close site polls while preserving existing vote rules.', actions: [{label: 'View public polls', url: '/polls'}]} only %}
    {% if message %}<p class="alert alert-success">{{ message }}</p>{% endif %}
    {% if error %}<p class="alert alert-error">{{ error }}</p>{% endif %}
    <details class="editor-panel" open>
        <summary><strong>{{ edit.id|default(null) ? 'Edit poll' : 'Create poll' }}</strong></summary>
        <form method="post" action="/admin/polls/save">
            <input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="id" value="{{ edit.id|default('') }}">
            <label class="wide-field">Question<input name="question" required minlength="5" maxlength="300" value="{{ edit.question|default('') }}"></label>
            <label class="wide-field">Options, one per line<textarea name="options" required rows="7">{% for option in edit.options|default([]) %}{{ option.label }}{% if not loop.last %}
{% endif %}{% endfor %}</textarea><small>Options cannot change after the first vote.</small></label>
            <div class="form-grid">
                <label>Status<select name="status"><option value="draft">Draft</option><option value="active" {{ edit.status|default('') == 'active' ? 'selected' : '' }}>Active</option><option value="closed" {{ edit.status|default('') == 'closed' ? 'selected' : '' }}>Closed</option></select></label>
                <label>Maximum selections<input type="number" name="max_selections" min="2" max="20" value="{{ edit.max_selections|default(2) }}"></label>
                <label>Starts at UTC<input type="datetime-local" name="starts_at" value="{{ edit.starts_at|default('',true)|replace({' ':'T'}) }}"></label>
                <label>Ends at UTC<input type="datetime-local" name="ends_at" value="{{ edit.ends_at|default('',true)|replace({' ':'T'}) }}"></label>
            </div>
            <label class="toggle-row"><input type="checkbox" name="allow_multiple" value="1" {{ edit.allow_multiple|default(false) ? 'checked' : '' }}><span><strong>Allow multiple selections</strong><small>Use the maximum-selections field to limit each voter.</small></span></label>
            <button type="submit">Save poll</button>
        </form>
    </details>
    <div class="module-section-heading"><div><h2>Poll inventory</h2><p>Review status and vote activity, then edit or remove a poll.</p></div></div>
    <div class="table-wrap"><table class="admin-table"><thead><tr><th>Question</th><th>Status</th><th>Votes</th><th>Actions</th></tr></thead><tbody>
        {% for poll in polls %}
        <tr><td><strong>{{ poll.question }}</strong></td><td><span class="badge {{ poll.status == 'active' ? 'badge-active' : '' }}">{{ poll.status }}</span></td><td>{{ poll.vote_count }}</td><td class="admin-actions-cell"><a class="content-action" href="/admin/polls?edit={{ poll.id }}">Edit</a><a class="content-action" href="/polls/{{ poll.id }}">View</a><form class="inline-form" method="post" action="/admin/polls/{{ poll.id }}/delete"><input type="hidden" name="_token" value="{{ csrf_token }}"><label><input type="checkbox" name="confirm_delete" value="1" required> Confirm</label><button class="danger-button">Delete</button></form></td></tr>
        {% else %}{% include 'components/admin-table-empty.twig' with {colspan: 4, title: 'No polls yet', message: 'Create the first poll using the editor above.'} only %}{% endfor %}
    </tbody></table></div>
</section>
{% endblock %}
