{% extends "layouts/default.twig" %}{% block title %}Statistics administration — NovaNuke{% endblock %}{% block content %}<section class="admin-page statistics-admin"><p class="eyebrow">Insights</p><h1>Statistics</h1>{% if message %}<p class="alert alert-success">{{ message }}</p>{% endif %}<div class="stat-grid"><article><strong>{{ summary.registered_users }}</strong><span>Registered users</span></article><article><strong>{{ summary.active_users }}</strong><span>Active in 30 days</span></article><article><strong>{{ summary.published_news }}</strong><span>Published news</span></article><article><strong>{{ summary.approved_comments }}</strong><span>Comments</span></article><article><strong>{{ summary.downloads }}</strong><span>Downloads</span></article><article><strong>{{ summary.views_30_days }}</strong><span>Views in 30 days</span></article></div>{% if can_manage %}<form class="settings-form" method="post" action="/admin/statistics/settings"><input type="hidden" name="_token" value="{{ csrf_token }}"><label class="toggle-row"><input type="checkbox" name="collection_enabled" value="1" {{ collection_enabled ? 'checked' : '' }}><span><strong>Collect aggregate traffic statistics</strong><small>No raw IP or complete user-agent is stored.</small></span></label><label class="toggle-row"><input type="checkbox" name="public_enabled" value="1" {{ public_enabled ? 'checked' : '' }}><span><strong>Enable public statistics page</strong><small>Makes the limited summary available at /statistics.</small></span></label><button>Save settings</button></form>{% endif %}<div class="statistics-columns"><section><h2>Sections</h2>{% include "@statistics/admin/table.twig" with {rows:sections,label:'section'} %}</section><section><h2>Referrers</h2>{% include "@statistics/admin/table.twig" with {rows:referrers,label:'referrer_host'} %}</section><section><h2>Devices</h2>{% include "@statistics/admin/table.twig" with {rows:devices,label:'device_type'} %}</section><section><h2>Browsers</h2>{% include "@statistics/admin/table.twig" with {rows:browsers,label:'browser_type'} %}</section></div><h2>Recent activity</h2><div class="table-wrap"><table class="admin-table"><thead><tr><th>Date</th><th>User</th><th>Action</th><th>Subject</th></tr></thead><tbody>{% for item in activity %}<tr><td>{{ item.created_at }}</td><td>{{ item.username|default('System',true) }}</td><td>{{ item.action }}</td><td>{{ item.subject_type }} {{ item.subject_id }}</td></tr>{% else %}<tr><td colspan="4">No activity.</td></tr>{% endfor %}</tbody></table></div><h2>Most viewed content</h2>{% for type,items in top %}<h3>{{ type|title }}</h3><div class="table-wrap"><table class="admin-table"><tbody>{% for item in items %}<tr><td>{{ item.title }}</td><td>{{ item.views }}</td></tr>{% else %}<tr><td colspan="2">No data.</td></tr>{% endfor %}</tbody></table></div>{% endfor %}</section>{% endblock %}
