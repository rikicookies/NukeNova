{% if rows %}
<div class="table-wrap"><table class="admin-table"><thead><tr><th>{{ label|replace({'_':' '})|title }}</th><th>Views</th></tr></thead><tbody>{% for item in rows %}<tr><td>{{ attribute(item,label) }}</td><td>{{ item.views }}</td></tr>{% endfor %}</tbody></table></div>
{% else %}
{% include 'components/empty-state.twig' with {title: 'No data yet', message: 'There is not enough aggregate activity for this breakdown yet.'} only %}
{% endif %}
