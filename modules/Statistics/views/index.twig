{% extends "layouts/default.twig" %}{% block title %}Site statistics — {{ cms_name|default('NovaNuke') }}{% endblock %}{% block content %}<section class="statistics-page"><p class="eyebrow">Community</p><h1>Site statistics</h1><div class="stat-grid"><article><strong>{{ summary.registered_users }}</strong><span>Registered users</span></article><article><strong>{{ summary.published_news }}</strong><span>Published news</span></article><article><strong>{{ summary.approved_comments }}</strong><span>Approved comments</span></article><article><strong>{{ summary.downloads }}</strong><span>Downloads</span></article><article><strong>{{ summary.views_30_days }}</strong><span>Views in 30 days</span></article></div><h2>Popular sections</h2><div class="table-wrap"><table class="admin-table"><thead><tr><th>Section</th><th>Views</th></tr></thead><tbody>{% for item in sections %}<tr><td>{{ item.section }}</td><td>{{ item.views }}</td></tr>{% else %}<tr><td colspan="2">No aggregate data yet.</td></tr>{% endfor %}</tbody></table></div><p><small>Statistics are aggregate and do not expose individual browsing histories.</small></p></section>{% endblock %}
