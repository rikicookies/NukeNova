{% extends "layouts/default.twig" %}{% block title %}{{ trans('media::title') }} — NovaNuke{% endblock %}{% block content %}<section class="admin-page media-page"><p class="eyebrow">{{ trans('media::eyebrow') }}</p><h1>{{ trans('media::title') }}</h1><p>{{ trans('media::description') }}</p>{% if message %}<div class="alert alert-success">{{ message }}</div>{% endif %}{% if error %}<div class="alert alert-error">{{ error }}</div>{% endif %}<form class="media-upload" method="post" action="/admin/media/upload" enctype="multipart/form-data"><input type="hidden" name="_token" value="{{ csrf_token }}"><label>{{ trans('media::image') }}<input type="file" name="image" accept="image/jpeg,image/png,image/webp" required></label><label>{{ trans('media::metadata_title') }}<input name="title" maxlength="160"></label><label>{{ trans('media::alt_text') }}<input name="alt_text" maxlength="255"></label><button type="submit">{{ trans('media::upload') }}</button></form>{% if images %}<div class="media-grid">{% for image in images %}<article class="media-card"><img src="{{ image.public_path }}" alt="{{ image.alt_text|default('',true) }}" loading="lazy"><div><strong>{{ image.title|default(image.original_name,true) }}</strong><small>{{ image.width }} × {{ image.height }} · {{ (image.file_size / 1024)|round }} KB · {{ image.username }}</small><label>{{ trans('media::public_path') }}<input readonly value="{{ image.public_path }}" onclick="this.select()"></label><form method="post" action="/admin/media/{{ image.id }}/update"><input type="hidden" name="_token" value="{{ csrf_token }}"><label>{{ trans('media::metadata_title') }}<input name="title" maxlength="160" value="{{ image.title|default('',true) }}"></label><label>{{ trans('media::alt_text') }}<input name="alt_text" maxlength="255" value="{{ image.alt_text|default('',true) }}"></label><button type="submit">{{ trans('media::save') }}</button></form><form class="media-delete" method="post" action="/admin/media/{{ image.id }}/delete"><input type="hidden" name="_token" value="{{ csrf_token }}"><label><input type="checkbox" name="confirm_delete" value="1" required> {{ trans('media::confirm_delete') }}</label><button class="danger-button" type="submit">{{ trans('media::delete') }}</button></form></div></article>{% endfor %}</div>{% else %}<p>{{ trans('media::empty') }}</p>{% endif %}</section>{% endblock %}
