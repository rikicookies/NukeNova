{% extends "layouts/default.twig" %}
{% block title %}{{ trans('media::title') }} — NovaNuke{% endblock %}
{% block content %}
<section class="admin-page media-page">
    {% include 'components/breadcrumbs.twig' with {items: [{label: 'Admin', url: '/admin'}, {label: trans('media::title')}]} only %}
    {% include 'components/page-header.twig' with {eyebrow: trans('media::eyebrow'), title: trans('media::title'), description: trans('media::description')} only %}
    {% if message %}<div class="alert alert-success">{{ message }}</div>{% endif %}
    {% if error %}<div class="alert alert-error">{{ error }}</div>{% endif %}
    <section class="module-section">
        <div class="module-section-heading"><div><h2>{{ trans('media::upload') }}</h2><p>Upload a verified JPEG, PNG or WebP image and add reusable metadata.</p></div></div>
        <form class="media-upload" method="post" action="/admin/media/upload" enctype="multipart/form-data">
            <input type="hidden" name="_token" value="{{ csrf_token }}">
            <label>{{ trans('media::image') }}<input type="file" name="image" accept="image/jpeg,image/png,image/webp" required></label>
            <div class="form-grid"><label>{{ trans('media::metadata_title') }}<input name="title" maxlength="160"></label><label>{{ trans('media::alt_text') }}<input name="alt_text" maxlength="255"></label></div>
            <button class="module-button-primary" type="submit">{{ trans('media::upload') }}</button>
        </form>
    </section>
    <div class="module-section-heading"><div><h2>Media library</h2><p>{{ images|length }} image{{ images|length == 1 ? '' : 's' }} available for content use.</p></div></div>
    {% if images %}
    <div class="media-grid">
        {% for image in images %}
        <article class="media-card">
            <img src="{{ image.public_path }}" alt="{{ image.alt_text|default('',true) }}" loading="lazy">
            <div>
                <strong>{{ image.title|default(image.original_name,true) }}</strong>
                <div class="surface-card-meta"><span>{{ image.width }} × {{ image.height }}</span><span>{{ (image.file_size / 1024)|round }} KB</span><span>{{ image.username }}</span></div>
                <label>{{ trans('media::public_path') }}<input readonly value="{{ image.public_path }}" onclick="this.select()"></label>
                <form class="form-surface" method="post" action="/admin/media/{{ image.id }}/update"><input type="hidden" name="_token" value="{{ csrf_token }}"><label>{{ trans('media::metadata_title') }}<input name="title" maxlength="160" value="{{ image.title|default('',true) }}"></label><label>{{ trans('media::alt_text') }}<input name="alt_text" maxlength="255" value="{{ image.alt_text|default('',true) }}"></label><button type="submit">{{ trans('media::save') }}</button></form>
                <form class="media-delete" method="post" action="/admin/media/{{ image.id }}/delete"><input type="hidden" name="_token" value="{{ csrf_token }}"><label class="toggle-row"><input type="checkbox" name="confirm_delete" value="1" required><span><strong>{{ trans('media::confirm_delete') }}</strong></span></label><button class="danger-button" type="submit">{{ trans('media::delete') }}</button></form>
            </div>
        </article>
        {% endfor %}
    </div>
    {% else %}
        {% include 'components/empty-state.twig' with {title: trans('media::empty'), message: 'Upload the first image using the form above.'} only %}
    {% endif %}
</section>
{% endblock %}
