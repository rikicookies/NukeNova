<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ cms_name|default('NovaNuke') }}{% endblock %}</title>
    <link rel="stylesheet" href="/assets/css/app.css">
    {% block meta %}{% endblock %}
</head>
<body>
    {% include "blocks/region.twig" with {items: blocks['header']|default([]), position: 'header'} %}
    <header class="site-header">
        <a class="brand" href="/">{{ cms_name|default('NovaNuke') }}</a>
        {% import "menus/navigation.twig" as navigation %}<nav aria-label="Primary navigation">{{ navigation.render(menus.primary|default([])) }}</nav>
    </header>
    <main class="page-shell">
        {% include "blocks/region.twig" with {items: blocks['before-content']|default([]), position: 'before-content'} %}
        {% block content %}{% endblock %}
        {% include "blocks/region.twig" with {items: blocks['after-content']|default([]), position: 'after-content'} %}
    </main>
    {% include "blocks/region.twig" with {items: blocks['footer']|default([]), position: 'footer'} %}
</body>
</html>
