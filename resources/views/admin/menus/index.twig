{% extends "layouts/default.twig" %}
{% block title %}Menus — NovaNuke{% endblock %}
{% macro item_fields(item, menu, roles) %}
<input type="hidden" name="id" value="{{ item.id|default('') }}"><input type="hidden" name="menu_id" value="{{ menu.id }}">
<div class="form-grid">
    <label>Title<input name="title" required maxlength="120" value="{{ item.title|default('') }}"></label>
    <label>Parent<select name="parent_id"><option value="">Top level</option>{% for candidate in menu.items %}{% if candidate.id != (item.id|default(0)) %}<option value="{{ candidate.id }}" {{ item.parent_id|default(null) == candidate.id ? 'selected' : '' }}>{{ candidate.title }}</option>{% endif %}{% endfor %}</select></label>
    <label>Link type<select name="link_type"><option value="internal" {{ item.link_type|default('internal') == 'internal' ? 'selected' : '' }}>Internal path</option><option value="module" {{ item.link_type|default('internal') == 'module' ? 'selected' : '' }}>Module slug</option><option value="external" {{ item.link_type|default('internal') == 'external' ? 'selected' : '' }}>External URL</option></select></label>
    <label>Destination<input name="target" required maxlength="2048" value="{{ item.target|default('/') }}" placeholder="/pages/about or welcome"></label>
    <label>Order<input type="number" name="sort_order" min="-10000" max="10000" value="{{ item.sort_order|default(0) }}"></label>
</div>
<fieldset><legend>Visible to roles</legend><small>No selection means everyone.</small><div class="role-checks">{% for role in roles %}<label><input type="checkbox" name="role_ids[]" value="{{ role.id }}" {{ role.id in (item.role_ids|default([])) ? 'checked' : '' }}>{{ role.name }}</label>{% endfor %}</div></fieldset>
<div class="inline-checks"><label><input type="checkbox" name="enabled" value="1" {{ item.enabled|default(1) ? 'checked' : '' }}> Enabled</label><label><input type="checkbox" name="new_window" value="1" {{ item.new_window|default(0) ? 'checked' : '' }}> Open external link in new tab</label></div>
{% endmacro %}

{% macro sortable_tree(items) %}
    {% for item in items %}
        <li class="admin-nav-sort-group primary-menu-sort-item {{ item.parent_id ? 'is-child' : 'is-top-level' }}"
            data-menu-item-id="{{ item.id }}"
            draggable="true">
            <header>
                <button type="button"
                        class="admin-nav-drag-handle"
                        aria-label="Drag {{ item.title }}"
                        title="Drag item">↕</button>

                <div class="primary-menu-sort-label">
                    <strong>{{ item.title }}</strong>
                    <small>{{ item.parent_id ? 'Child item' : 'Top level' }} · {{ item.url }}</small>
                </div>

                <span class="admin-nav-move-buttons">
                    <button type="button"
                            data-public-move="up"
                            title="Move up"
                            aria-label="Move {{ item.title }} up">↑</button>
                    <button type="button"
                            data-public-move="down"
                            title="Move down"
                            aria-label="Move {{ item.title }} down">↓</button>
                </span>
            </header>

            {% if item.children %}
                <ul class="primary-menu-children" data-public-menu-items>
                    {{ _self.sortable_tree(item.children) }}
                </ul>
            {% endif %}
        </li>
    {% endfor %}
{% endmacro %}
{% block content %}
<section class="admin-page menus-admin">{% include 'components/breadcrumbs.twig' with {items: [{label: 'Admin', url: '/admin'}, {label: 'Menus'}]} only %}{% include 'components/page-header.twig' with {eyebrow: 'Navigation', title: 'Menus', description: 'Create independent navigation sets and arrange their links into parent/child levels.'} only %}
{% if message %}<div class="success-message">{{ message }}</div>{% endif %}{% if error %}<div class="form-errors"><ul><li>{{ error }}</li></ul></div>{% endif %}

<section class="admin-navigation-order" data-admin-nav-order>
    <div class="module-section-heading">
        <div>
            <h2>Administration navigation order</h2>
            <p>Drag groups and links to arrange the NovaModern administration sidebar. The saved order applies site-wide; permissions still decide which links each administrator can see.</p>
        </div>
    </div>
    <form method="post" action="/admin/navigation/order" data-admin-nav-order-form>
        <input type="hidden" name="_token" value="{{ csrf_token }}">
        <input type="hidden" name="navigation_order" value="" data-admin-nav-order-value>
        <div class="admin-nav-sorter" data-admin-nav-groups>
            {% for group in admin_navigation|default([]) %}
                <section class="admin-nav-sort-group" data-nav-group="{{ group.slug }}" draggable="true">
                    <header>
                        <button type="button" class="admin-nav-drag-handle" aria-label="Drag {{ group.label }} group" title="Drag group">↕</button>
                        <strong>{{ group.label }}</strong>
                        <span class="admin-nav-move-buttons">
                            <button type="button" data-move="up" aria-label="Move {{ group.label }} up">↑</button>
                            <button type="button" data-move="down" aria-label="Move {{ group.label }} down">↓</button>
                        </span>
                    </header>
                    <ul data-nav-items>
                        {% for item in group.items %}
                            <li data-nav-url="{{ item.url }}" draggable="true">
                                <button type="button" class="admin-nav-drag-handle" aria-label="Drag {{ item.label }}" title="Drag item">↕</button>
                                <span>{{ item.label }}</span>
                                <span class="admin-nav-move-buttons">
                                    <button type="button" data-move="up" aria-label="Move {{ item.label }} up">↑</button>
                                    <button type="button" data-move="down" aria-label="Move {{ item.label }} down">↓</button>
                                </span>
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endfor %}
        </div>
        <p class="admin-nav-order-help">Drag on desktop, or use ↑/↓ controls on touch devices. Reload after saving to see the sidebar in its new order.</p>
        <button type="submit">Save navigation order</button>
    </form>
</section>
<script src="/assets/js/admin-navigation-order.js" defer></script>
<script src="/assets/js/public-menu-order.js" defer></script>

{% for primary_menu in menu_list %}
    {% if primary_menu.slug == 'primary' %}
        <section class="admin-navigation-order primary-navigation-order" data-public-menu-order>
            <div class="module-section-heading">
                <div>
                    <h2>Primary navigation order</h2>
                    <p>Arrange the main public NovaModern sidebar exactly like the administration navigation above.</p>
                </div>
            </div>

            <form method="post" action="/admin/menus/{{ primary_menu.id }}/order" data-public-menu-order-form>
                <input type="hidden" name="_token" value="{{ csrf_token }}">
                <input type="hidden" name="item_order" value="" data-public-menu-order-value>

                <div class="admin-nav-sorter primary-menu-sorter" data-public-menu-items>
                    {{ _self.sortable_tree(primary_menu.tree|default([])) }}
                </div>

                {% if primary_menu.items %}
                    <p class="admin-nav-order-help">Drag on desktop, or use ↑/↓ on touch devices. Child items stay inside their current parent.</p>
                    <button type="submit">Save primary navigation order</button>
                {% else %}
                    <p class="admin-nav-order-help">Primary navigation does not have any links yet.</p>
                {% endif %}
            </form>
        </section>
    {% endif %}
{% endfor %}
<details class="editor-panel"><summary>Create menu</summary><form method="post" action="/admin/menus/save"><input type="hidden" name="_token" value="{{ csrf_token }}"><div class="form-grid"><label>Name<input name="name" required maxlength="120"></label><label>Slug<input name="slug" required pattern="[a-z][a-z0-9-]*" maxlength="100"></label><label>Description<input name="description" maxlength="255"></label></div><label><input type="checkbox" name="enabled" value="1" checked> Enabled</label><button type="submit">Create menu</button></form></details>
{% for menu in menu_list %}<article class="menu-editor"><form method="post" action="/admin/menus/save"><input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="id" value="{{ menu.id }}"><div class="module-heading"><div><h2>{{ menu.name }}</h2><code>{{ menu.slug }}</code></div><span class="badge {{ menu.enabled ? 'badge-active' : '' }}">{{ menu.enabled ? 'Enabled' : 'Disabled' }}</span></div><div class="form-grid"><label>Name<input name="name" value="{{ menu.name }}" required maxlength="120"></label><label>Slug<input name="slug" value="{{ menu.slug }}" required pattern="[a-z][a-z0-9-]*"></label><label>Description<input name="description" value="{{ menu.description|default('', true) }}" maxlength="255"></label></div><label><input type="checkbox" name="enabled" value="1" {{ menu.enabled ? 'checked' : '' }}> Enabled</label><button type="submit">Save menu</button></form>
<details class="editor-panel"><summary>Add item to {{ menu.name }}</summary><form method="post" action="/admin/menu-items/save"><input type="hidden" name="_token" value="{{ csrf_token }}">{{ _self.item_fields({}, menu, roles) }}<button type="submit">Add item</button></form></details>

<div class="menu-items">{% for item in menu.items %}<details class="editor-panel"><summary><strong>{{ item.title }}</strong> <small>{{ item.parent_id ? 'Child item' : 'Top level' }} · {{ item.url }}</small></summary><form method="post" action="/admin/menu-items/save"><input type="hidden" name="_token" value="{{ csrf_token }}">{{ _self.item_fields(item, menu, roles) }}<button type="submit">Save item</button></form><form class="delete-block-form" method="post" action="/admin/menu-items/{{ item.id }}/delete"><input type="hidden" name="_token" value="{{ csrf_token }}"><label><input type="checkbox" name="confirm_delete" value="1" required> Delete this item and its children</label><button class="danger-button" type="submit">Delete item</button></form></details>{% else %}<p>No items.</p>{% endfor %}</div>
<form class="delete-block-form menu-delete" method="post" action="/admin/menus/{{ menu.id }}/delete"><input type="hidden" name="_token" value="{{ csrf_token }}"><label><input type="checkbox" name="confirm_delete" value="1" required> Delete menu and all items</label><button class="danger-button" type="submit">Delete menu</button></form></article>{% endfor %}
</section>
{% endblock %}
