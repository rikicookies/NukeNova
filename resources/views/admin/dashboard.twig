{% extends "layouts/default.twig" %}
{% block title %}Dashboard — NovaNuke{% endblock %}
{% block content %}
<section class="dashboard-card">
    <p class="eyebrow">Admin dashboard</p>
    <h1>Hello, {{ user.username }}.</h1>
    <p>Your authenticated NovaNuke administration session is active.</p>
    <div class="dashboard-grid">
        <article><strong>Core</strong><span>Running</span></article>
        <article><strong>Account</strong><span>Super Administrator</span></article>
        <article><strong>Next</strong><span>Permissions and recovery</span></article>
    </div>
    <nav class="admin-links">
        <a href="/admin/users">Users</a>
        <a href="/admin/roles">Roles &amp; permissions</a>
        <a href="/admin/settings/users">Registration settings</a>
        <a href="/admin/logs">Activity logs</a>
        <a href="/admin/modules">Modules</a>
        <a href="/admin/themes">Themes</a>
        <a href="/admin/blocks">Blocks</a>
        <a href="/admin/menus">Menus</a>
    </nav>
    <form method="post" action="/logout"><input type="hidden" name="_token" value="{{ csrf_token }}"><button class="secondary-button" type="submit">Sign out</button></form>
</section>
{% endblock %}
