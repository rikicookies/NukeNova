{% extends "layouts/default.twig" %}
{% block title %}Memberships — NovaNuke{% endblock %}
{% block content %}
<section class="admin-page">
{% include 'components/breadcrumbs.twig' with {items:[{label:'Admin',url:'/admin'},{label:'Memberships'}]} only %}
{% include 'components/page-header.twig' with {eyebrow:'Access',title:'Memberships',description:'Assign and monitor Free and VIP access without payment processing.'} only %}
<div class="dashboard-cards">
<article class="dashboard-card"><strong>{{ membership_counts.active }}</strong><span>Active VIP</span></article>
<article class="dashboard-card"><strong>{{ membership_counts.expiring }}</strong><span>Expiring within 7 days</span></article>
<article class="dashboard-card"><strong>{{ membership_counts.lifetime }}</strong><span>Lifetime VIP</span></article>
<article class="dashboard-card"><strong>{{ membership_counts.scheduled }}</strong><span>Scheduled</span></article>
<article class="dashboard-card"><strong>{{ membership_counts.inactive }}</strong><span>Expired / revoked</span></article>
</div>
<form class="settings-form" method="get" action="/admin/memberships">
<label>Status<select name="status">
{% for key,label in {'active':'Active VIP','expiring':'Expiring soon','lifetime':'Lifetime','scheduled':'Scheduled','inactive':'Expired/revoked','never':'Never VIP','all':'All users'} %}
<option value="{{ key }}" {% if selected_status==key %}selected{% endif %}>{{ label }}</option>{% endfor %}
</select></label>
<label>Search<input type="search" name="q" maxlength="100" value="{{ search }}" placeholder="Username or email"></label>
<button type="submit">Filter</button>
</form>
<div class="table-wrap"><table class="admin-table">
<thead><tr><th>User</th><th>Membership</th><th>Period</th><th>Source</th><th>Manage</th></tr></thead>
<tbody>
{% for item in memberships %}
<tr>
<td><strong>{{ item.username }}</strong><small>{{ item.email }}</small></td>
<td>{% if item.membership_active %}<span class="badge badge-active">{{ item.plan_key|default('vip-custom')|replace({'-':' '})|title }}</span>
{% elseif item.starts_at and item.starts_at > "now"|date("Y-m-d H:i:s") %}<span class="badge">Scheduled — {{ item.plan_key|replace({'-':' '})|title }}</span>
{% elseif item.plan_key %}<span class="badge">Inactive — {{ item.plan_key|replace({'-':' '})|title }}</span>
{% else %}<span class="badge">Free</span>{% endif %}</td>
<td>{% if item.membership_active and not item.expires_at %}Lifetime{% elseif item.expires_at %}{{ item.starts_at }} → {{ item.expires_at }} UTC{% else %}—{% endif %}</td>
<td>{{ item.source|default('—') }}{% if item.note %}<small>{{ item.note }}</small>{% endif %}</td>
<td>
<form class="settings-form" method="post" action="/admin/memberships/{{ item.id }}/assign">
<input type="hidden" name="_token" value="{{ csrf_token }}">
<select name="plan" required>{% for key,plan in membership_plans %}<option value="{{ key }}">{{ plan.name }}</option>{% endfor %}</select>
<input type="text" name="note" maxlength="255" placeholder="Optional note">
<button type="submit">Assign</button>
</form>
{% if item.membership_active %}<form method="post" action="/admin/memberships/{{ item.id }}/revoke" onsubmit="return confirm('Revoke VIP access now?')">
<input type="hidden" name="_token" value="{{ csrf_token }}"><button class="secondary-button" type="submit">Revoke</button></form>{% endif %}
<a href="/admin/memberships/{{ item.id }}">Membership history</a> · <a href="/admin/users/{{ item.id }}">Open user</a>
</td>
</tr>
{% else %}
{% include 'components/admin-table-empty.twig' with {colspan:5,title:'No memberships found',message:'No users match this membership filter.'} only %}
{% endfor %}
</tbody></table></div>
</section>
{% endblock %}
