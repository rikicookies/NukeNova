{% extends "layouts/default.twig" %}
{% block title %}Roles — NovaNuke{% endblock %}
{% block content %}
<section class="admin-page">
    {% include 'components/breadcrumbs.twig' with {items: [{label: 'Admin', url: '/admin'}, {label: 'Roles'}]} only %}
    {% include 'components/page-header.twig' with {eyebrow: 'Authorization', title: 'Roles', description: 'Review role permissions enforced by NovaNuke on protected operations.'} only %}
    <div class="table-wrap"><table class="admin-table">
        <thead><tr><th>Role</th><th>Slug</th><th>Permissions</th><th>Actions</th></tr></thead>
        <tbody>{% for role in roles %}<tr>
            <td><strong>{{ role.name }}</strong>{% if role.description %}<small>{{ role.description }}</small>{% endif %}</td>
            <td><code>{{ role.slug }}</code></td>
            <td>{{ role.permission_count }}</td>
            <td class="admin-actions-cell">{% include 'components/admin-row-actions.twig' with {label: 'Actions for ' ~ role.name, actions: [{label: role.slug == 'super-administrator' ? 'View' : 'View / edit', url: '/admin/roles/' ~ role.id}]} only %}</td>
        </tr>{% else %}{% include 'components/admin-table-empty.twig' with {colspan: 4, title: 'No roles found', message: 'No roles are currently available.'} only %}{% endfor %}</tbody>
    </table></div>
</section>
{% endblock %}
