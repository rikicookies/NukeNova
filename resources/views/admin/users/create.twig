{% extends "layouts/default.twig" %}
{% block title %}Create account — NovaNuke{% endblock %}
{% block content %}
<section class="admin-page">
    <p class="eyebrow">Accounts</p>
    <h1>Create account</h1>
    <p>Create an active, email-verified account without opening public registration.</p>
    {% if errors %}<div class="alert alert-error"><strong>Please correct the form.</strong><ul>{% for error in errors %}<li>{{ error }}</li>{% endfor %}</ul></div>{% endif %}
    <form class="settings-form admin-form" method="post" action="/admin/users">
        <input type="hidden" name="_token" value="{{ csrf_token }}">
        <label>Username<input name="username" required minlength="3" maxlength="32" value="{{ old.username|default('') }}" autocomplete="off"></label>
        <label>Email<input type="email" name="email" required maxlength="254" value="{{ old.email|default('') }}" autocomplete="off"></label>
        <label>Initial password<input type="password" name="password" required minlength="12" maxlength="255" autocomplete="new-password"></label>
        <label>Confirm password<input type="password" name="password_confirmation" required minlength="12" maxlength="255" autocomplete="new-password"></label>
        <label>Role<select name="role_id" required><option value="">Select a role</option>{% for role in roles %}<option value="{{ role.id }}"{% if old.role_id|default('') == role.id %} selected{% endif %}>{{ role.name }} ({{ role.slug }})</option>{% endfor %}</select></label>
        <label class="toggle-row"><input type="checkbox" name="must_change_password" value="1" checked><span><strong>Require password change</strong><small>The user must replace the initial password before accessing the rest of the site.</small></span></label>
        <button type="submit">Create account</button>
    </form>
    <p><a href="/admin/users">Return to users</a></p>
</section>
{% endblock %}
