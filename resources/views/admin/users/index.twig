{% extends "layouts/default.twig" %}
{% block title %}Users — NovaNuke{% endblock %}
{% block content %}
<section class="admin-page">
    {% include 'components/breadcrumbs.twig' with {items: [{label: 'Admin', url: '/admin'}, {label: 'Users'}]} only %}
    {% include 'components/page-header.twig' with {
        eyebrow: 'Accounts',
        title: 'Users',
        description: 'Review account status, role assignments and memberships.',
        actions: can_create_account ? [{label: 'Create account', url: '/admin/users/create'}] : []
    } only %}
    <nav class="context-actions" aria-label="Filter users by membership status">
        <a href="/admin/users"{% if vip_filter == 'all' %} aria-current="page"{% endif %}>All</a>
        <a href="/admin/users?vip=active"{% if vip_filter == 'active' %} aria-current="page"{% endif %}>Active VIP</a>
        <a href="/admin/users?vip=inactive"{% if vip_filter == 'inactive' %} aria-current="page"{% endif %}>Expired/revoked</a>
        <a href="/admin/users?vip=none"{% if vip_filter == 'none' %} aria-current="page"{% endif %}>Never VIP</a>
    </nav>
    <div class="table-wrap"><table class="admin-table">
        <thead><tr><th>User</th><th>Status</th><th>Membership</th><th>Roles</th><th>Last login</th><th>Actions</th></tr></thead>
        <tbody>{% for item in users %}<tr>
            <td><strong>{{ item.username }}</strong><small>{{ item.email }}</small></td>
            <td><span class="badge badge-{{ item.status }}">{{ item.status }}</span></td>
            <td>{% if item.vip_status == 'active' %}<span class="badge badge-active">{{ item.membership_plan|default('vip-custom')|replace({'-': ' '})|title }}</span><small>{% if item.vip_expires_at %}Expires {{ item.vip_expires_at }} UTC{% if item.vip_expiring_soon %} · within 7 days{% endif %}{% else %}Lifetime access{% endif %}</small>{% elseif item.vip_status == 'inactive' %}<span class="badge">Expired/revoked</span><small>Latest expiration {{ item.vip_expires_at }} UTC</small>{% else %}<span class="badge">Never VIP</span>{% endif %}</td>
            <td>{{ item.roles ?: 'No role' }}</td>
            <td>{{ item.last_login_at ?: 'Never' }}</td>
            <td class="admin-actions-cell">{% include 'components/admin-row-actions.twig' with {label: 'Actions for ' ~ item.username, actions: [{label: 'Manage', url: '/admin/users/' ~ item.id}]} only %}</td>
        </tr>{% else %}{% include 'components/admin-table-empty.twig' with {colspan: 6, title: 'No users found', message: 'No users match this VIP filter.'} only %}{% endfor %}</tbody>
    </table></div>
</section>
{% endblock %}
