{% extends "layouts/default.twig" %}
{% block title %}Email verification — NovaNuke{% endblock %}
{% block content %}
<section class="auth-card">
    <p class="eyebrow">Email verification</p>
    {% if verified %}
        <h1>Your email is verified.</h1>
        <p>Your Member account is active.</p>
        <a class="install-button link-button" href="/login">Sign in</a>
    {% else %}
        <h1>This link is no longer valid.</h1>
        <p>The verification link is invalid, expired or has already been used.</p>
        <a class="auth-link" href="/resend-verification">{{ trans('auth.verification.resend_link') }}</a>
    {% endif %}
</section>
{% endblock %}
