{% extends "layouts/default.twig" %}
{% block title %}Reset password — NovaNuke{% endblock %}
{% block content %}
<section class="auth-card">
    <p class="eyebrow">Account recovery</p>
    <h1>Reset your password.</h1>
    {% if sent %}
        <div class="success-message">If an active account matches that email, a recovery message has been created.</div>
        <p>During local development, open <code>storage/logs/mail.log</code> and follow the newest link.</p>
    {% else %}
        <p>Enter the email associated with your account.</p>
        {% if error %}<div class="form-errors"><ul><li>{{ error }}</li></ul></div>{% endif %}
        <form method="post" action="/forgot-password">
            <input type="hidden" name="_token" value="{{ csrf_token }}">
            <label>Email<input type="email" name="email" required autocomplete="email"></label>
            <button type="submit">Create recovery link</button>
            <a class="auth-link" href="/login">Return to sign in</a>
        </form>
    {% endif %}
</section>
{% endblock %}
