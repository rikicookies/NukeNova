{% extends "layouts/default.twig" %}
{% block title %}Account created — NovaNuke{% endblock %}
{% block content %}
<section class="auth-card">
    <p class="eyebrow">Account created</p>
    <h1>Welcome to NovaNuke.</h1>
    {% if verification_required %}
        <p>Check your inbox and open the newest verification link. During local development it is written to <code>storage/logs/mail.log</code>.</p>
        <a class="auth-link" href="/resend-verification">{{ trans('auth.verification.resend_link') }}</a>
    {% else %}
        <p>Your account is active and ready to use.</p>
        <a class="install-button link-button" href="/login">Sign in</a>
    {% endif %}
</section>
{% endblock %}
