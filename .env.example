APP_NAME=NovaNuke
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_KEY=

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=novanuke
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

SESSION_NAME=novanuke_session
SESSION_SECURE=false
SESSION_SAME_SITE=Lax

SECURITY_HEADERS_ENABLED=true
# Enable HSTS only after production HTTPS works correctly.
SECURITY_HSTS_ENABLED=false
SECURITY_HSTS_MAX_AGE=31536000

MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@localhost
MAIL_FROM_NAME=NovaNuke
# Production example: MAIL_MAILER=smtp. Use the exact server shown by your host.
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_TIMEOUT=15
