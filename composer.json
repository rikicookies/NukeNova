{
    "name": "novanuke/novanuke",
    "description": "A lightweight, modular CMS inspired by the simplicity of PHP-Nuke.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "twig/twig": "^3.10",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "files": [
            "app/Support/helpers.php"
        ],
        "psr-4": {
            "NovaNuke\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NovaNuke\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "migrate": "php bin/cms migrate",
        "test": "phpunit",
        "serve": "php -S 127.0.0.1:8080 -t public"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": false
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
