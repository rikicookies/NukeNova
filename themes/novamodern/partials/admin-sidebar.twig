{% import 'partials/icon.twig' as icons %}
<aside class="nova-sidebar nova-admin-sidebar" id="nova-admin-sidebar" data-sidebar>
    <div class="nova-sidebar-heading"><span class="nova-sidebar-icon">{{ icons.render('dashboard', theme.asset_base) }}</span><strong>Administration</strong></div>
    <nav aria-label="Administration">
        {% for group in admin_navigation|default([]) %}
            <section class="nova-nav-group">
                <h2>{{ group.label }}</h2>
                <ul>
                    {% for item in group.items %}
                        <li class="{{ item.active ? 'is-active' : '' }}">
                            <a href="{{ item.url }}" title="{{ item.label }}">
                                {{ icons.render(item.icon, theme.asset_base) }}<span>{{ item.label }}</span>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% else %}
            <p class="nova-nav-empty">No administrative sections available.</p>
        {% endfor %}
    </nav>
</aside>
