<!doctype html>
<html lang="en" style="--theme-accent: {{ theme.settings.accent_color }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ cms_name|default('NovaNuke') }}{% endblock %}</title>
    <link rel="stylesheet" href="/assets/css/app.css">
    <link rel="stylesheet" href="{{ theme.asset_base }}/css/theme.css">
    {% block meta %}{% endblock %}
</head>
<body class="theme-default">
    {% include "blocks/region.twig" with {items: blocks['header']|default([]), position: 'header'} %}
    {% include "partials/header.twig" %}
    <main class="theme-shell">
        {% include "blocks/region.twig" with {items: blocks['before-content']|default([]), position: 'before-content'} %}
        {% block content %}{% endblock %}
        {% include "blocks/region.twig" with {items: blocks['after-content']|default([]), position: 'after-content'} %}
    </main>
    {% include "partials/footer.twig" %}
    {% include "blocks/region.twig" with {items: blocks['footer']|default([]), position: 'footer'} %}
</body>
</html>
