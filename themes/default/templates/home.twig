{% extends "layouts/default.twig" %}
{% block content %}
<div class="nova-home-columns {{ blocks['left-sidebar']|default([]) ? 'has-left' : '' }} {{ blocks['right-sidebar']|default([]) ? 'has-right' : '' }}">
{% if blocks['left-sidebar']|default([]) %}<aside>{% include "blocks/region.twig" with {items: blocks['left-sidebar'], position: 'left-sidebar'} %}</aside>{% endif %}
<section class="nova-hero">
    {% if theme.settings.show_version %}<p class="eyebrow">Version {{ version }}</p>{% endif %}
    <h1>NovaNuke is ready to grow.</h1>
    <p>{{ theme.settings.site_tagline }}</p>
    <div class="nova-actions">
        {% if user %}
            <span>Signed in as <strong>{{ user.username }}</strong></span>
            <form method="post" action="/logout"><input type="hidden" name="_token" value="{{ csrf_token }}"><button class="secondary-button" type="submit">Sign out</button></form>
        {% else %}
            <a href="/login">Sign in</a><a href="/register">Create account</a>
        {% endif %}
    </div>
</section>
{% if blocks['right-sidebar']|default([]) %}<aside>{% include "blocks/region.twig" with {items: blocks['right-sidebar'], position: 'right-sidebar'} %}</aside>{% endif %}
</div>
{% endblock %}
