<header class="classic-header"><div><a href="/">{{ cms_name|default('NovaNuke') }}</a><small>{{ theme.settings.site_tagline }}</small></div>{% import "menus/navigation.twig" as navigation %}<nav aria-label="{{ trans('common.primary_navigation') }}">{{ navigation.render(menus.primary|default([])) }}</nav>{% if current_user %}{% if notification_unread_count is defined %}<a href="/notifications">{{ trans('notifications::nav') }}{% if notification_unread_count > 0 %} ({{ notification_unread_count }}){% endif %}</a>{% endif %}<a href="/account/profile">{{ trans('account.settings') }}</a>{% endif %}</header>
