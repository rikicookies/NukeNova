{% extends "layouts/default.twig" %}
{% block content %}
<div class="classic-columns">
    <aside><div class="classic-panel"><h2>Navigation</h2><a href="/welcome">Welcome module</a><a href="/register">Register</a></div>{% include "blocks/region.twig" with {items: blocks['left-sidebar']|default([]), position: 'left-sidebar'} %}</aside>
    <section class="classic-story"><p class="classic-topic">LATEST NEWS</p><h1>Welcome to your portal</h1><p>{{ theme.settings.site_tagline }}</p>{% if theme.settings.show_version %}<small>NovaNuke {{ version }}</small>{% endif %}</section>
    <aside><div class="classic-panel"><h2>Account</h2>{% if user %}<p>{{ user.username }}</p><form method="post" action="/logout"><input type="hidden" name="_token" value="{{ csrf_token }}"><button type="submit">Sign out</button></form>{% else %}<a href="/login">Sign in</a>{% endif %}</div>{% include "blocks/region.twig" with {items: blocks['right-sidebar']|default([]), position: 'right-sidebar'} %}</aside>
</div>
{% endblock %}
