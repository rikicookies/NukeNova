{% extends "layouts/default.twig" %}
{% block content %}
<div class="classic-columns">
    <aside><div class="classic-panel"><h2>{{ trans('theme::home.navigation') }}</h2><a href="/welcome">{{ trans('theme::home.welcome_module') }}</a><a href="/register">{{ trans('theme::home.register') }}</a></div>{% include "blocks/region.twig" with {items: blocks['left-sidebar']|default([]), position: 'left-sidebar'} %}</aside>
    <section class="classic-story"><p class="classic-topic">{{ trans('theme::home.latest_news') }}</p><h1>{{ trans('theme::home.portal') }}</h1><p>{{ theme.settings.site_tagline }}</p>{% if theme.settings.show_version %}<small>NovaNuke {{ version }}</small>{% endif %}</section>
    <aside><div class="classic-panel"><h2>{{ trans('theme::home.account') }}</h2>{% if user %}<p>{{ user.username }}</p><form method="post" action="/logout"><input type="hidden" name="_token" value="{{ csrf_token }}"><button type="submit">{{ trans('common.sign_out') }}</button></form>{% else %}<a href="/login">{{ trans('common.sign_in') }}</a>{% endif %}</div>{% include "blocks/region.twig" with {items: blocks['right-sidebar']|default([]), position: 'right-sidebar'} %}</aside>
</div>
{% endblock %}
